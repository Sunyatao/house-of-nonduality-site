---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "nl" | "en";
}

const {
  title,
  description = "House of Nonduality — stilte, poëzie en contemplatieve ontmoeting.",
  lang = "nl",
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-season="spring">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="site-shell">
      <Header lang={lang} />

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>© House of Nonduality</p>
      </footer>
    </div>
  </body>
</html>