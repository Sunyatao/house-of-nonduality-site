---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description?: string;
  lang?: "nl" | "en";
  hideHeader?: boolean;
}

const {
  title = "The House of Nonduality",
  description = "",
  lang = "nl",
  hideHeader = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} data-season="spring">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}favicon.ico`} />
    <title>{title}</title>
  
    <style is:inline>
  .site-header {
    padding: 24px 0 10px;
  }

  .home-house {
    margin: 12px auto 80px;
  }

  .page-image-hero {
    margin: 12px auto 72px;
  }

  .hero-card,
  .about-scene .about-panel {
    opacity: 0;
  }

  @media (max-width: 760px) {
    .site-header {
      padding-top: 18px;
      padding-bottom: 6px;
    }

    .home-house {
      margin-top: 8px;
      margin-bottom: 56px;
    }

    .page-image-hero {
      margin: 8px auto 56px;
    }
  }
</style>
  
  </head>

  <body>
    <div class="site-shell">
      {!hideHeader && <Header lang={lang} />}

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>© House of Nonduality</p>
      </footer>
    </div>
  </body>
</html>