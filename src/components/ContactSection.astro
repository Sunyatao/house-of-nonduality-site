---
interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const content = {
  nl: {
    title: "Contact",
    lead: "Heb je een vraag over The House of Nonduality, wil je deelnemen aan een bijeenkomst, of wil je gewoon even contact opnemen? Je bent welkom om een bericht te sturen.",
    detailsTitle: "Contactgegevens",
    formTitle: "Stuur een bericht",
    formIntro: "Wil je deelnemen aan de Open Tafel of Woorden uit de Stilte? Vermeld dan even je naam, de bijeenkomst waarvoor je wil inschrijven en met hoeveel personen je komt.",
    emailLabel: "E-mail",
    locationLabel: "Locatie",
    location: "Leuven — adres na inschrijving",
    follow: "Volg The House of Nonduality",
    name: "Naam",
    email: "E-mail",
    subject: "Onderwerp",
    message: "Je bericht",
    button: "Verzend",
  },
  en: {
    title: "Contact",
    lead: "Do you have a question about The House of Nonduality, would you like to join a gathering, or simply get in touch? You are welcome to send a message.",
    detailsTitle: "Contact details",
    formTitle: "Send a message",
    formIntro: "Would you like to join Open Table or Words from Silence? Please mention your name, the gathering you would like to attend and how many people are coming.",
    emailLabel: "E-mail",
    locationLabel: "Location",
    location: "Leuven — address after registration",
    follow: "Follow The House of Nonduality",
    name: "Name",
    email: "E-mail",
    subject: "Subject",
    message: "Your message",
    button: "Send",
  },
};

const t = content[lang];
---

<section class="contact-page">
  <div class="branch branch-left" aria-hidden="true"></div>
  <div class="branch branch-right" aria-hidden="true"></div>

  <div class="contact-intro">
    <h1>{t.title}</h1>
    <div class="ornament-line" aria-hidden="true"><span>☉</span></div>
    <p class="lead">{t.lead}</p>
  </div>

  <div class="contact-grid">
    <article class="contact-panel">
      <h2>{t.detailsTitle}</h2>
      <div class="mini-ornament" aria-hidden="true">— ❧ • ❧ —</div>

      <div class="contact-detail-block">
        <div class="contact-icon">✉</div>
        <h3>{t.emailLabel}</h3>
        <a href="mailto:contact@houseofnonduality.com">
          contact@houseofnonduality.com
        </a>
      </div>

      <div class="soft-divider" aria-hidden="true"></div>

      <div class="contact-detail-block">
        <div class="contact-icon">⌖</div>
        <h3>{t.locationLabel}</h3>
        <p>{t.location}</p>
      </div>

      <div class="soft-divider" aria-hidden="true"></div>

      <div class="contact-detail-block">
        <div class="contact-icon">☙</div>
        <h3>{t.follow}</h3>
        <p>
          <a href="#">Facebook</a>
          <span class="dot">·</span>
          <a href="#">Instagram</a>
        </p>
      </div>
    </article>

    <article class="contact-panel">
      <h2>{t.formTitle}</h2>
      <div class="mini-ornament" aria-hidden="true">— ❧ • ❧ —</div>

      <p class="form-intro">{t.formIntro}</p>

      <form class="contact-form" action="#" method="post">
        <input type="text" name="name" placeholder={t.name} autocomplete="name" />
        <input type="email" name="email" placeholder={t.email} autocomplete="email" />
        <input type="text" name="subject" placeholder={t.subject} />
        <textarea name="message" rows="5" placeholder={t.message}></textarea>

        <button class="send-button" type="submit">
          <span></span>
          {t.button}
          <span></span>
        </button>
      </form>
    </article>
  </div>

  <div class="landscape-placeholder" aria-hidden="true"></div>
  <div class="bottom-ornament" aria-hidden="true">— ☉ —</div>
</section>