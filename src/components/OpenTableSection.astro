---
import PageImageHero from "./PageImageHero.astro";

interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const t =
  lang === "nl"
    ? {
        kicker: "Een mogelijke vorm",
        title: "Open Tafel",
        lead: "Een eenvoudige ontmoeting rond eten, gesprek, contemplatie en samenzijn.",
        viewRoom: "Bekijk de kamer",
        showInfo: "Toon info",
        imageAlt:
          "Een warme houten eetkamer met een lange tafel, open deuren naar het landschap en een inkomhal links.",
        introTitle: "Samen eten, samen vertragen",
        intro:
          "Open Tafel is een kleinschalige bijeenkomst in Leuven rond een eenvoudige maaltijd. We eten samen, er is ruimte voor zowel gesprek als stilte, en er wordt een korte filosofische of contemplatieve tekst voorgelezen. Tot slot maken we eventueel een kleine wandeling in het groen, als het weer dat toelaat.",
        rhythmTitle: "Hoe verloopt het?",
        rhythm:
          "We beginnen rustig, met tijd om aan te komen en elkaar te ontmoeten. Daarna eten we samen aan tafel. Later op de middag lezen we een korte tekst en laten we ruimte voor wat daaruit ontstaat: stilte, gesprek of eenvoudige reflectie. Als het weer het toelaat, sluiten we af met een korte wandeling in het groen.",
        forWhomTitle: "Voor wie?",
        forWhom:
          "Voor wie graag op een rustige manier mensen ontmoet rond zingeving, stilte, filosofie, spiritualiteit of gewoon een goed gesprek. Je hoeft geen ervaring met meditatie, nondualiteit of filosofie te hebben.",
        practicalTitle: "Praktisch",
        practical: [
          "Niet volgens een vast ritme",
          "Datum, locatie en vorm worden per bijeenkomst aangekondigd",
        ],
        datesTitle: "Volgende bijeenkomst",
        noDates: "Er staat momenteel geen Open Tafel gepland.",
        ctaTitle: "Wil je weten wanneer er een nieuwe bijeenkomst ontstaat?",
        cta: "Nieuwe bijeenkomsten worden aangekondigd via de nieuwsbrief.",
        ctaLink: "/nl/nieuwsbrief/",
        ctaLabel: "Blijf op de hoogte",
        secondaryLink: "/nl/contact/",
        secondaryLabel: "Contact",
      }
    : {
        kicker: "A possible form",
        title: "Open Table",
        lead: "A simple gathering around food, conversation, contemplation and presence.",
        viewRoom: "View the room",
        showInfo: "Show info",
        imageAlt:
          "A warm wooden dining room with a long table, open doors to the landscape and an entrance hall on the left.",
        introTitle: "Eating together, slowing down together",
        intro:
          "Open Table is a small-scale gathering in Leuven around a simple meal. We eat together, there is room for both conversation and silence, and a short philosophical or contemplative text is read aloud. To close, we may take a short walk in the green, if the weather allows.",
        rhythmTitle: "How does it unfold?",
        rhythm:
          "We begin quietly, with time to arrive and meet one another. Then we share a meal around the table. Later in the afternoon, we read a short text and make space for whatever it opens: silence, conversation or simple reflection. If the weather allows, we close with a short walk in the green.",
        forWhomTitle: "For whom?",
        forWhom:
          "For anyone who would like to meet others in a quiet way around meaning, silence, philosophy, spirituality or simply a good conversation. No experience with meditation, nonduality or philosophy is needed.",
        practicalTitle: "Practical",
        practical: [
          "No fixed rhythm",
          "The date, location and form will be announced for each gathering",
        ],
        datesTitle: "Next gathering",
        noDates: "There is currently no Open Table scheduled.",
        ctaTitle: "Would you like to know when a new gathering takes shape?",
        cta: "New gatherings will be announced through the newsletter.",
        ctaLink: "/en/newsletter/",
        ctaLabel: "Stay informed",
        secondaryLink: "/en/contact/",
        secondaryLabel: "Contact",
      };
---

<section class="detail-page">
  <PageImageHero
    kicker={t.kicker}
    title={t.title}
    lead={t.lead}
    imageSrc="/images/open-table/hond-dining-room-spring.png"
    imageAlt={t.imageAlt}
    showImageView={true}
    imageViewLabel={t.viewRoom}
    imageInfoLabel={t.showInfo}
  >
    <section class="hero-card-grid open-table-hero-grid open-table-all-cards">
      <article class="hero-card open-table-hero-card hero-card-large">
        <h2>{t.introTitle}</h2>
        <p>{t.intro}</p>
      </article>

      <article class="hero-card open-table-hero-card">
        <h2>{t.rhythmTitle}</h2>
        <p>{t.rhythm}</p>
      </article>

      <article class="hero-card open-table-hero-card">
        <h2>{t.forWhomTitle}</h2>
        <p>{t.forWhom}</p>
      </article>

      <article class="hero-card open-table-hero-card">
        <h2>{t.practicalTitle}</h2>
        <ul class="detail-meta-list">
          {t.practical.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="hero-card open-table-hero-card">
        <h2>{t.datesTitle}</h2>
        <p>{t.noDates}</p>
      </article>

      <article class="hero-card open-table-hero-card hero-card-callout">
  <h2>{t.ctaTitle}</h2>
  <p>{t.cta}</p>
  <div class="hero-card-actions">
    <a class="button primary" href={withBase(t.ctaLink)}>
      {t.ctaLabel}
    </a>
    <a class="button" href={withBase(t.secondaryLink)}>
      {t.secondaryLabel}
    </a>
  </div>
</article>
    </section>
  </PageImageHero>
</section>
