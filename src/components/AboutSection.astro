---
interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const t =
  lang === "nl"
    ? {
      title: "Over het Huis",
      lead: "Een levende plek voor stilte, onderzoek en ontmoeting.",
      introTitle: "Wat blijft",
      intro:
        "Vormen kunnen veranderen. Wat blijft, is een verlangen naar vertraging, diepgang en echte ontmoeting. Het Huis van Nondualiteit maakt ruimte om samen aandachtig te kijken naar ervaring, bewustzijn, lijden en de vraag wat we werkelijk zijn. Niet als een afgewerkt systeem, maar als een levend onderzoek. Het initiatief groeit vanuit Leuven en wordt gedragen door Pieter Abts.",
      nondualityTitle: "Wat betekent nondualiteit?",
      nonduality:
        "Nondualiteit verwijst naar het inzicht dat de werkelijkheid niet werkelijk uiteenvalt in een afgescheiden ‘ik’ hier en een wereld daarbuiten. Het is geen overtuiging die je moet aannemen, maar een uitnodiging om in de directe ervaring te onderzoeken waar die scheiding precies te vinden is — en wat er overblijft wanneer we haar niet langer als vanzelfsprekend beschouwen.",
      wuWeiTitle: "Niet forceren",
      wuWei:
        "De nieuwe koers van het Huis sluit aan bij het daoïstische begrip wu wei: handelen zonder te forceren. Dat betekent niet passief afwachten of alles aan het toeval overlaten, maar luisteren voordat je handelt en alleen vorm geven wanneer inhoud, plek en moment werkelijk samenvallen.",
      practiceTitle: "Hoe krijgt het Huis vorm?",
      practice:
        "Het Huis kan vorm krijgen in een tekst, lezing, gesprek, wandeling, avond rond poëzie of dag samen. Die vorm staat niet vooraf vast en hoeft niet volgens een maandelijks ritme herhaald te worden. Ze dient wat op dat moment onderzocht of gedeeld wil worden.",
      houseTitle: "Waarom een huis?",
      house:
        "Een huis is een plaats van aankomst. Je hoeft er niets te bewijzen. Je kunt binnenkomen, plaatsnemen, luisteren, lezen, spreken, wandelen of stil zijn. De verschillende kamers zijn geen afzonderlijke programma’s, maar ingangen naar dezelfde open ruimte voor aandacht en onderzoek.",
      quote:
        "Niet om ergens anders te geraken, maar om helderder te zien wat hier al is.",
      imageAlt:
        "Het Huis van Nondualiteit als warm huis met verschillende kamers.",
      }
    : {
      title: "About the House",
      lead: "A living place for silence, inquiry and encounter.",
      introTitle: "What remains",
      intro:
        "Forms can change. What remains is a longing for slowness, depth and genuine encounter. The House of Nonduality creates space to look attentively at experience, consciousness, suffering and the question of what we truly are. Not as a finished system, but as a living inquiry. The initiative takes shape in Leuven through the work of Pieter Abts.",
      nondualityTitle: "What does nonduality mean?",
      nonduality:
        "Nonduality points to the insight that reality does not truly fall apart into a separate “I” here and a world out there. It is not a belief to adopt, but an invitation to examine in direct experience where that separation can actually be found — and what remains when we no longer take it for granted.",
      wuWeiTitle: "Without forcing",
      wuWei:
        "The new direction of the House resonates with the Daoist notion of wu wei: acting without forcing. This does not mean passively waiting or leaving everything to chance, but listening before acting and giving form only when content, place and moment genuinely come together.",
      practiceTitle: "How does the House take shape?",
      practice:
        "The House may take shape in a text, a talk, a conversation, a walk, an evening of poetry or a day together. That form is not fixed in advance and need not be repeated according to a monthly rhythm. It serves what calls to be explored or shared at that moment.",
      houseTitle: "Why a house?",
      house:
        "A house is a place of arrival. You do not have to prove anything there. You can enter, take a seat, listen, read, speak, walk or be still. Its different rooms are not separate programmes, but doorways into the same open space for attention and inquiry.",
      quote:
        "Not to get somewhere else, but to see more clearly what is already here.",
      imageAlt:
        "The House of Nonduality as a warm house with different rooms.",
      };

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};
---

<section class="about-scene">
  <div class="about-scene-heading">
    <h1>{t.title}</h1>
    <p>{t.lead}</p>
  </div>

  <picture>
    <source srcset={withBase("/images/home/hond-home-inn-spring.avif")} type="image/avif" />
    <source srcset={withBase("/images/home/hond-home-inn-spring.webp")} type="image/webp" />
    <img
      src={withBase("/images/home/hond-home-inn-spring.png")}
      alt={t.imageAlt}
      width="1600"
      height="1000"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="about-scene-overlay">
    <section class="about-grid">
      <article class="about-panel about-panel-large">
        <h2>{t.introTitle}</h2>
        <p>{t.intro}</p>
      </article>

      <article class="about-panel">
        <h2>{t.nondualityTitle}</h2>
        <p>{t.nonduality}</p>
      </article>

      <article class="about-panel">
        <h2>{t.wuWeiTitle}</h2>
        <p>{t.wuWei}</p>
      </article>

      <article class="about-panel">
        <h2>{t.practiceTitle}</h2>
        <p>{t.practice}</p>
      </article>

      <article class="about-panel">
        <h2>{t.houseTitle}</h2>
        <p>{t.house}</p>
      </article>
    </section>
  </div>
</section>

<section class="about-quote">
  <p>{t.quote}</p>
</section>
