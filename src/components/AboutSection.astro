---
interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const t = lang === "nl"
  ? {
      title: "Over het Huis",
      lead: "Een plek voor stilte, contemplatie, openheid en ontmoeting.",
      introTitle: "Een huis voor stilte en inzicht",
      intro:
        "Het Huis van Nondualiteit is geen kerk, school of klassieke spirituele organisatie. Het is eerder een open huis: een plek voor stilte, contemplatie, ontmoeting en de vraag wat werkelijk is. Naast de bijeenkomsten groeit hier ook een verzameling teksten, stemmen en inzichten uit verschillende tradities — niet als laatste woord, maar als uitnodiging tot dieper kijken.",
      nondualityTitle: "Wat betekent nondualiteit?",
      nonduality:
        "Nondualiteit verwijst naar het inzicht dat de werkelijkheid minder verdeeld is dan ze op het eerste gezicht lijkt: niet een afgescheiden ‘ik’ hier, tegenover een wereld daarbuiten. In eenvoudige woorden: nondualiteit nodigt uit om te onderzoeken of we werkelijk zo afgescheiden zijn als we denken.",
      practiceTitle: "Hoe krijgt dat vorm?",
      practice:
        "Het Huis krijgt vorm via bijeenkomsten, contemplatieve teksten, gedeelde maaltijden, gesprek, poëzie, meditatie en een groeiende verzameling bronnen. Niet als doctrine of overtuiging, maar als uitnodiging om rechtstreeks te onderzoeken wat aanwezig is.",
      houseTitle: "Waarom een huis?",
      house:
        "Een huis is een plaats van aankomst. Je hoeft er niets te bewijzen. Je komt binnen, neemt plaats, luistert, eet, leest, schrijft, reflecteert, of volgt een spoor dat je dieper naar binnen brengt. De website volgt diezelfde logica: elke kamer opent een andere ingang tot stilte, contemplatie en de vraag wat werkelijk is.",
      quote:
        "Niet om ergens anders te geraken, maar om helderder te zien wat hier al is.",
      imageAlt:
        "Het Huis van Nondualiteit als warm huis met verschillende kamers.",
    }
  : {
      title: "About the House",
      lead: "A place for silence, contemplation, openness and encounter.",
      introTitle: "A house for silence and insight",
      intro:
        "The House of Nonduality is not a church, school, or classical spiritual organization. It is rather an open house: a place for silence, contemplation, encounter, and the question of what is real. Alongside the gatherings, a growing collection of texts, voices, and insights from different traditions is taking shape here — not as a final word, but as an invitation to look more deeply.",
      nondualityTitle: "What does nonduality mean?",
      nonduality:
        "Nonduality points to the insight that reality is less divided than it may first appear: not a separate “I” over here, facing a world out there. In simple words: nonduality invites us to explore whether we are really as separate as we think.",
      practiceTitle: "How does this take form?",
      practice:
        "The House takes shape through silent gatherings, contemplative texts, shared meals, conversation, poetry, meditation, and a growing collection of sources. Not as doctrine or belief, but as an invitation to directly explore what is present.",
      houseTitle: "Why a house?",
      house:
        "A house is a place of arrival. You do not have to prove anything there. You enter, take a seat, listen, eat, read, write, reflect, or follow a thread that leads you deeper within. The website follows that same logic: each room opens a different doorway into silence, contemplation, and the question of what is real.",
      quote:
        "Not to get somewhere else, but to see more clearly what is already here.",
      imageAlt:
        "The House of Nonduality as a warm house with different rooms.",
    };

    const base = import.meta.env.BASE_URL;

    const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};
---

  <section class="about-scene">
  <div class="about-scene-heading">
    <h1>{t.title}</h1>
    <p>{t.lead}</p>
  </div>

<picture>
  <source srcset={withBase("/images/home/hond-home-inn-spring.avif")} type="image/avif" />
  <source srcset={withBase("/images/home/hond-home-inn-spring.webp")} type="image/webp" />
  <img
    src={withBase("/images/home/hond-home-inn-spring.png")}
    alt={t.imageAlt}
    width="1600"
    height="1000"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</picture>

  <div class="about-scene-overlay">
      <section class="about-grid">
        <article class="about-panel about-panel-large">
          <h2>{t.introTitle}</h2>
          <p>{t.intro}</p>
        </article>

        <article class="about-panel">
          <h2>{t.nondualityTitle}</h2>
          <p>{t.nonduality}</p>
        </article>

        <article class="about-panel">
          <h2>{t.practiceTitle}</h2>
          <p>{t.practice}</p>
        </article>

        <article class="about-panel about-panel-large">
          <h2>{t.houseTitle}</h2>
          <p>{t.house}</p>
        </article>
      </section>
    </div>
  </section>

  <section class="about-quote">
    <p>{t.quote}</p>
  </section>
</section>