---
interface Props {
  lang?: "nl" | "en";
}

const { lang = "nl" } = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const normalizePath = (pathname: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;

  let normalized = pathname;

  if (normalized.startsWith(cleanBase)) {
    normalized = `/${normalized.slice(cleanBase.length)}`;
  }

  if (!normalized.endsWith("/")) {
    normalized = `${normalized}/`;
  }

  return normalized;
};

const path = normalizePath(Astro.url.pathname);

const nav = lang === "nl"
  ? [
      { href: "/nl/", label: "Home", matches: ["/nl/"] },
      { href: "/nl/over/", label: "Over", matches: ["/nl/over/"] },
      {
        href: "/nl/bijeenkomsten/",
        label: "Bijeenkomsten",
        matches: [
          "/nl/bijeenkomsten/",
          "/nl/open-tafel/",
          "/nl/woorden-uit-de-stilte/",
        ],
        children: [
  {
    href: "/nl/open-tafel/",
    label: "Open Tafel",
    matches: ["/nl/open-tafel/"],
  },
  {
    href: "/nl/woorden-uit-de-stilte/",
    label: "Woorden uit de Stilte",
    matches: ["/nl/woorden-uit-de-stilte/"],
  },
],
},
      { href: "/nl/nieuwsbrief/", label: "Nieuwsbrief", matches: ["/nl/nieuwsbrief/"] },
      { href: "/nl/contact/", label: "Contact", matches: ["/nl/contact/"] },
    ]
  : [
      { href: "/en/", label: "Home", matches: ["/en/"] },
      { href: "/en/about/", label: "About", matches: ["/en/about/"] },
      {
  href: "/en/gatherings/",
  label: "Gatherings",
  matches: [
    "/en/gatherings/",
    "/en/open-table/",
    "/en/words-from-silence/",
  ],
  children: [
  {
    href: "/en/open-table/",
    label: "Open Table",
    matches: ["/en/open-table/"],
  },
  {
    href: "/en/words-from-silence/",
    label: "Words from Silence",
    matches: ["/en/words-from-silence/"],
  },
],
},
      { href: "/en/newsletter/", label: "Newsletter", matches: ["/en/newsletter/"] },
      { href: "/en/contact/", label: "Contact", matches: ["/en/contact/"] },
    ];

const languagePairs: Record<string, string> = {
  "/nl/": "/en/",
  "/en/": "/nl/",
  "/nl/over/": "/en/about/",
  "/en/about/": "/nl/over/",
  "/nl/bijeenkomsten/": "/en/gatherings/",
  "/en/gatherings/": "/nl/bijeenkomsten/",
  "/nl/open-tafel/": "/en/open-table/",
  "/en/open-table/": "/nl/open-tafel/",
  "/nl/woorden-uit-de-stilte/": "/en/words-from-silence/",
  "/en/words-from-silence/": "/nl/woorden-uit-de-stilte/",
  "/nl/nieuwsbrief/": "/en/newsletter/",
  "/en/newsletter/": "/nl/nieuwsbrief/",
  "/nl/contact/": "/en/contact/",
  "/en/contact/": "/nl/contact/",
};

const switchToOtherLanguage = languagePairs[path] ?? (lang === "nl" ? "/en/" : "/nl/");
---

<style is:inline>
  .submenu {
    position: absolute;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 8px);
  }

  @media (max-width: 760px) {
    .submenu {
      position: static;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
    }
  }
</style>

<header class="site-header">
  <a class="brand" href={withBase(lang === "nl" ? "/nl/" : "/en/")}>
  <span class="brand-mark" aria-hidden="true">
  <img
    src={withBase("/images/logo/hond-logo-gold-transparent.png")}
    alt=""
    width="78"
    height="78"
    class="brand-logo"
    style="width: 78px; height: 64px; object-fit: contain; display: block;"
  />
</span>

    <span class="brand-text">
      <span class="brand-small">
        {lang === "nl" ? "Het Huis van" : "The House of"}
      </span>
      <span class="brand-large">
        {lang === "nl" ? "Nondualiteit" : "Nonduality"}
      </span>
    </span>
  </a>

  <nav class="main-nav" aria-label="Main navigation">
    {nav.map((item) => {
  const isActive =
    item.matches.includes(path) ||
    item.children?.some((child) => child.matches.includes(path));

  if (item.children) {
    return (
      <div class="nav-item has-submenu">
        <a
          href={withBase(item.href)}
          class:list={["nav-link", isActive && "is-active"]}
          aria-haspopup="true"
        >
          {item.label}
        </a>

        <div class="submenu" aria-label={`${item.label} submenu`}>
          {item.children.map((child) => {
            const childIsActive = child.matches.includes(path);

            return (
              <a
                href={withBase(child.href)}
                class:list={["submenu-link", childIsActive && "is-active"]}
              >
                {child.label}
              </a>
            );
          })}
        </div>
      </div>
    );
  }

  return (
    <a
      href={withBase(item.href)}
      class:list={["nav-link", isActive && "is-active"]}
    >
      {item.label}
    </a>
  );
})}

<div class="language-switch" aria-label="Language switcher">
  {lang === "nl" ? (
    <>
      <a href={withBase(switchToOtherLanguage)}>EN</a>
      <span>|</span>
      <a class="is-active" href={withBase(path)}>NL</a>
    </>
  ) : (
    <>
      <a class="is-active" href={withBase(path)}>EN</a>
      <span>|</span>
      <a href={withBase(switchToOtherLanguage)}>NL</a>
    </>
  )}
</div>
  </nav>
</header>