---
interface Props {
  lang?: "nl" | "en";
}

const { lang = "nl" } = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const normalizePath = (pathname: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;

  let normalized = pathname;

  if (normalized.startsWith(cleanBase)) {
    normalized = `/${normalized.slice(cleanBase.length)}`;
  }

  if (!normalized.endsWith("/")) {
    normalized = `${normalized}/`;
  }

  return normalized;
};

const path = normalizePath(Astro.url.pathname);

const nav =
  lang === "nl"
    ? [
        { href: "/nl/", label: "Home", matches: ["/nl/"] },
        { href: "/nl/over/", label: "Over", matches: ["/nl/over/"] },
        {
          href: "/nl/bijeenkomsten/",
          label: "Bijeenkomsten",
          matches: [
            "/nl/bijeenkomsten/",
            "/nl/open-tafel/",
            "/nl/woorden-uit-de-stilte/",
            "/nl/agenda/",
            "/nl/inschrijven/",
          ],
        },
        {
          href: "/nl/sporen-van-inzicht/",
          label: "Teksten",
          matches: ["/nl/sporen-van-inzicht/"],
        },
        {
          href: "/nl/nieuwsbrief/",
          label: "Nieuwsbrief",
          matches: ["/nl/nieuwsbrief/"],
        },
        { href: "/nl/contact/", label: "Contact", matches: ["/nl/contact/"] },
      ]
    : [
        { href: "/en/", label: "Home", matches: ["/en/"] },
        { href: "/en/about/", label: "About", matches: ["/en/about/"] },
        {
          href: "/en/gatherings/",
          label: "Gatherings",
          matches: [
            "/en/gatherings/",
            "/en/open-table/",
            "/en/words-from-silence/",
            "/en/calendar/",
            "/en/register/",
          ],
        },
        {
          href: "/en/traces-of-insight/",
          label: "Texts",
          matches: ["/en/traces-of-insight/"],
        },
        {
          href: "/en/newsletter/",
          label: "Newsletter",
          matches: ["/en/newsletter/"],
        },
        { href: "/en/contact/", label: "Contact", matches: ["/en/contact/"] },
      ];

const languagePairs: Record<string, string> = {
  "/nl/": "/en/",
  "/en/": "/nl/",
  "/nl/over/": "/en/about/",
  "/en/about/": "/nl/over/",
  "/nl/bijeenkomsten/": "/en/gatherings/",
  "/en/gatherings/": "/nl/bijeenkomsten/",
  "/nl/open-tafel/": "/en/open-table/",
  "/en/open-table/": "/nl/open-tafel/",
  "/nl/woorden-uit-de-stilte/": "/en/words-from-silence/",
  "/en/words-from-silence/": "/nl/woorden-uit-de-stilte/",
  "/nl/agenda/": "/en/calendar/",
  "/en/calendar/": "/nl/agenda/",
  "/nl/sporen-van-inzicht/": "/en/traces-of-insight/",
  "/en/traces-of-insight/": "/nl/sporen-van-inzicht/",
  "/nl/nieuwsbrief/": "/en/newsletter/",
  "/en/newsletter/": "/nl/nieuwsbrief/",
  "/nl/contact/": "/en/contact/",
  "/en/contact/": "/nl/contact/",
  "/nl/inschrijven/": "/en/register/",
  "/en/register/": "/nl/inschrijven/",
  "/nl/privacy/": "/en/privacy/",
  "/en/privacy/": "/nl/privacy/",
};

const switchToOtherLanguage =
  languagePairs[path] ?? (lang === "nl" ? "/en/" : "/nl/");
---

<header class="site-header">
  <a class="brand" href={withBase(lang === "nl" ? "/nl/" : "/en/")}>
    <span class="brand-mark" aria-hidden="true">
      <img
        src={withBase("/images/logo/hond-logo-gold-transparent.png")}
        alt=""
        width="78"
        height="78"
        class="brand-logo"
        style="width: 78px; height: 64px; object-fit: contain; display: block;"
      />
    </span>

    <span class="brand-text">
      <span class="brand-small">
        {lang === "nl" ? "Het Huis van" : "The House of"}
      </span>
      <span class="brand-large">
        {lang === "nl" ? "Nondualiteit" : "Nonduality"}
      </span>
    </span>
  </a>

  <nav class="main-nav" aria-label="Main navigation">
    {nav.map((item) => {
      const isActive = item.matches.includes(path);

      return (
        <a
          href={withBase(item.href)}
          class:list={["nav-link", isActive && "is-active"]}
        >
          {item.label}
        </a>
      );
    })}

    <div class="language-switch" aria-label="Language switcher">
      {lang === "nl" ? (
        <>
          <a href={withBase(switchToOtherLanguage)}>EN</a>
          <span>|</span>
          <a class="is-active" href={withBase(path)}>NL</a>
        </>
      ) : (
        <>
          <a class="is-active" href={withBase(path)}>EN</a>
          <span>|</span>
          <a href={withBase(switchToOtherLanguage)}>NL</a>
        </>
      )}
    </div>
  </nav>
</header>
