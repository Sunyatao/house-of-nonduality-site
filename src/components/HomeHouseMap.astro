---
interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const t = lang === "nl"
  ? {
      title: "Het Huis van Nondualiteit",
      lead: "Een ruimte voor stilte, poëzie en contemplatieve ontmoeting.",
      alt: "Een warme herberg met kamers voor ontmoeting, stilte, contact, meditatie en studie.",
      about: "Over",
      openTable: "Open Tafel",
      words: "Woorden uit de Stilte",
      contact: "Contact",
      newsletter: "Nieuwsbrief",
      library: "Bibliotheek",
      meditation: "Meditatie",
      soon: "binnenkort",
      links: {
        about: "/nl/over/",
        openTable: "/nl/open-tafel/",
        words: "/nl/woorden-uit-de-stilte/",
        contact: "/nl/contact/",
        newsletter: "/nl/nieuwsbrief/",
        library: "/nl/bibliotheek/",
      },
    }
  : {
      title: "The House of Nonduality",
      lead: "A space for silence, poetry and contemplative encounter.",
      alt: "A warm inn with rooms for gathering, silence, contact, meditation and study.",
      about: "About",
      openTable: "Open Table",
      words: "Words from Silence",
      contact: "Contact",
      newsletter: "Newsletter",
      library: "Library",
      meditation: "Meditation",
      soon: "coming soon",
      links: {
        about: "/en/about/",
        openTable: "/en/open-table/",
        words: "/en/words-from-silence/",
        contact: "/en/contact/",
        newsletter: "/en/newsletter/",
        library: "/en/library/",
      },
    };
---

<section class="home-house" aria-label={lang === "nl" ? "Verken het Huis van Nondualiteit" : "Explore the House of Nonduality"}>
  <img
    class="home-house-image"
    src="/images/home/hond-home-inn-spring.png"
    alt={t.alt}
  />

  <div class="home-house-welcome" aria-hidden="true">
  <h1>{t.title}</h1>
  <p>{t.lead}</p>
</div>

  <a class="house-hotspot hotspot-open-table" href={t.links.openTable} data-tooltip={t.openTable}></a>

  <a class="house-hotspot hotspot-words" href={t.links.words} data-tooltip={t.words}></a>

  <a class="house-hotspot hotspot-contact" href={t.links.contact} data-tooltip={t.contact}></a>

  <a class="house-hotspot hotspot-newsletter" href={t.links.newsletter} data-tooltip={t.newsletter}></a>

  <a class="house-hotspot hotspot-about" href={t.links.about} data-tooltip={t.about}></a>

  <a class="house-hotspot hotspot-library" href={t.links.library} data-tooltip={t.library}></a>

  <div class="house-hotspot hotspot-meditation is-disabled" data-tooltip={`${t.meditation} · ${t.soon}`}></div>
</section>

  <div class="house-cursor-tooltip" aria-hidden="true"></div>

<section class="home-house-links" aria-label={lang === "nl" ? "Kamers van het Huis" : "Rooms of the House"}>
  <a href={t.links.openTable}>{t.openTable}</a>
  <a href={t.links.words}>{t.words}</a>
  <a href={t.links.contact}>{t.contact}</a>
  <a href={t.links.newsletter}>{t.newsletter}</a>
  <a href={t.links.about}>{t.about}</a>
  <a href={t.links.library}>{t.library}</a>
  <span>{t.meditation} · {t.soon}</span>
</section>

<script>
  const homeHouse = document.querySelector<HTMLElement>(".home-house");
  const tooltip = document.querySelector<HTMLElement>(".house-cursor-tooltip");

  if (homeHouse && tooltip) {
    const hotspots = homeHouse.querySelectorAll<HTMLElement>("[data-tooltip]");

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener("mouseenter", () => {
        tooltip.textContent = hotspot.dataset.tooltip || "";
        tooltip.classList.add("is-visible");
      });

      hotspot.addEventListener("mousemove", (event: MouseEvent) => {
        tooltip.style.left = `${event.clientX}px`;
        tooltip.style.top = `${event.clientY}px`;
      });

      hotspot.addEventListener("mouseleave", () => {
        tooltip.classList.remove("is-visible");
      });

      hotspot.addEventListener("focus", () => {
        tooltip.textContent = hotspot.dataset.tooltip || "";
        tooltip.classList.add("is-visible");
      });

      hotspot.addEventListener("blur", () => {
        tooltip.classList.remove("is-visible");
      });
    });
  }
</script>