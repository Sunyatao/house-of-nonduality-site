---
interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const t =
  lang === "nl"
    ? {
        title: "Het Huis van Nondualiteit",
        lead:
          "Het Huis van Nondualiteit is een plek voor stilte, onderzoek en ontmoeting. Het krijgt telkens opnieuw vorm — in een tekst, een lezing, een gesprek, een wandeling of een dag samen — zonder dat die vorm vooraf vastligt.",
        alt: "Een warme herberg met kamers voor ontmoeting, schrijven, studie en contemplatie.",
        exploreLabel: "Verken het Huis van Nondualiteit",
        mobileLinksLabel: "Ingangen van het Huis",
        about: "Over het Huis",
        gatherings: "Bijeenkomsten",
        texts: "Teksten",
        contact: "Contact",
        newsletter: "Nieuwsbrief",
        newsletterTitle: "Blijf verbonden",
        newsletterText:
          "Nieuwe bijeenkomsten, teksten en andere initiatieven volgen geen vast ritme. Via de nieuwsbrief hoor je wanneer er iets nieuws vorm krijgt.",
        newsletterCta: "Schrijf je in",
        links: {
          about: "/nl/over/",
          gatherings: "/nl/bijeenkomsten/",
          texts: "/nl/sporen-van-inzicht/",
          contact: "/nl/contact/",
          newsletter: "/nl/nieuwsbrief/",
        },
      }
    : {
        title: "The House of Nonduality",
        lead:
          "The House of Nonduality is a place for silence, inquiry and encounter. It takes shape anew each time — in a text, a talk, a conversation, a walk or a day together — without that form being fixed in advance.",
        alt: "A warm inn with rooms for encounter, writing, study and contemplation.",
        exploreLabel: "Explore The House of Nonduality",
        mobileLinksLabel: "Entrances of the House",
        about: "About the House",
        gatherings: "Gatherings",
        texts: "Texts",
        contact: "Contact",
        newsletter: "Newsletter",
        newsletterTitle: "Stay connected",
        newsletterText:
          "New gatherings, texts and other initiatives do not follow a fixed rhythm. The newsletter lets you know when something new takes shape.",
        newsletterCta: "Subscribe",
        links: {
          about: "/en/about/",
          gatherings: "/en/gatherings/",
          texts: "/en/traces-of-insight/",
          contact: "/en/contact/",
          newsletter: "/en/newsletter/",
        },
      };
---

<section class="home-house-intro">
  <h1>{t.title}</h1>
  <p>{t.lead}</p>
</section>

<section class="home-house" aria-label={t.exploreLabel}>
  <picture>
    <source srcset={withBase("/images/home/hond-home-inn-spring.avif")} type="image/avif" />
    <source srcset={withBase("/images/home/hond-home-inn-spring.webp")} type="image/webp" />
    <img
      class="home-house-image"
      src={withBase("/images/home/hond-home-inn-spring.png")}
      alt={t.alt}
      width="1600"
      height="1000"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <a
    class="house-hotspot hotspot-gatherings"
    href={withBase(t.links.gatherings)}
    data-tooltip={t.gatherings}
    aria-label={t.gatherings}
  ></a>

  <a
    class="house-hotspot hotspot-contact"
    href={withBase(t.links.contact)}
    data-tooltip={t.contact}
    aria-label={t.contact}
  ></a>

  <a
    class="house-hotspot hotspot-newsletter"
    href={withBase(t.links.newsletter)}
    data-tooltip={t.newsletter}
    aria-label={t.newsletter}
  ></a>

  <a
    class="house-hotspot hotspot-about"
    href={withBase(t.links.about)}
    data-tooltip={t.about}
    aria-label={t.about}
  ></a>

  <a
    class="house-hotspot hotspot-library hotspot-texts"
    href={withBase(t.links.texts)}
    data-tooltip={t.texts}
    aria-label={t.texts}
  ></a>
</section>

<div class="house-cursor-tooltip" aria-hidden="true"></div>

<section class="home-house-links" aria-label={t.mobileLinksLabel}>
  <a href={withBase(t.links.about)}>{t.about}</a>
  <a href={withBase(t.links.gatherings)}>{t.gatherings}</a>
  <a href={withBase(t.links.texts)}>{t.texts}</a>
  <a href={withBase(t.links.contact)}>{t.contact}</a>
</section>

<section class="home-house-follow" aria-labelledby={`home-newsletter-${lang}`}>
  <div>
    <p class="home-house-follow-kicker">{t.newsletter}</p>
    <h2 id={`home-newsletter-${lang}`}>{t.newsletterTitle}</h2>
    <p>{t.newsletterText}</p>
  </div>

  <a class="button primary" href={withBase(t.links.newsletter)}>
    {t.newsletterCta}
  </a>
</section>

<script>
  const homeHouse = document.querySelector<HTMLElement>(".home-house");
  const tooltip = document.querySelector<HTMLElement>(".house-cursor-tooltip");

  if (homeHouse && tooltip) {
    const hotspots = homeHouse.querySelectorAll<HTMLElement>("[data-tooltip]");

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener("mouseenter", () => {
        tooltip.textContent = hotspot.dataset.tooltip || "";
        tooltip.classList.add("is-visible");
      });

      hotspot.addEventListener("mousemove", (event: MouseEvent) => {
        tooltip.style.left = `${event.clientX}px`;
        tooltip.style.top = `${event.clientY}px`;
      });

      hotspot.addEventListener("mouseleave", () => {
        tooltip.classList.remove("is-visible");
      });

      hotspot.addEventListener("focus", () => {
        tooltip.textContent = hotspot.dataset.tooltip || "";
        tooltip.classList.add("is-visible");
      });

      hotspot.addEventListener("blur", () => {
        tooltip.classList.remove("is-visible");
      });
    });
  }
</script>
