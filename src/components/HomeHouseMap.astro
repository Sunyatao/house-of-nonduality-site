---
interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const t =
  lang === "nl"
    ? {
        title: "Het Huis van Nondualiteit",
        lead: "Een plek voor stilte, contemplatie, openheid en ontmoeting.",
        alt: "Een plek voor stilte, contemplatie, openheid en ontmoeting.",
        about: "Over",
        openTable: "Open Tafel",
        words: "Woorden uit de Stilte",
        contact: "Contact",
        newsletter: "Nieuwsbrief",
        traces: "Sporen van Inzicht",
        meditation: "Meditatie",
        soon: "binnenkort",
        links: {
          about: "/nl/over/",
          openTable: "/nl/open-tafel/",
          words: "/nl/woorden-uit-de-stilte/",
          contact: "/nl/contact/",
          newsletter: "/nl/nieuwsbrief/",
          traces: "/nl/sporen-van-inzicht/",
        },
      }
    : {
        title: "The House of Nonduality",
        lead: "A place for silence, contemplation, openness and encounter.",
        alt: "A place for silence, contemplation, openness and encounter.",
        about: "About",
        openTable: "Open Table",
        words: "Words from Silence",
        contact: "Contact",
        newsletter: "Newsletter",
        traces: "Traces of Insight",
        meditation: "Meditation",
        soon: "coming soon",
        links: {
          about: "/en/about/",
          openTable: "/en/open-table/",
          words: "/en/words-from-silence/",
          contact: "/en/contact/",
          newsletter: "/en/newsletter/",
          traces: "/en/traces-of-insight/",
        },
      };
---

<section
  class="home-house"
  aria-label={lang === "nl" ? "Verken het Huis van Nondualiteit" : "Explore the House of Nonduality"}
>
  <picture>
    <source srcset={withBase("/images/home/hond-home-inn-spring.avif")} type="image/avif" />
    <source srcset={withBase("/images/home/hond-home-inn-spring.webp")} type="image/webp" />
    <img
      class="home-house-image"
      src={withBase("/images/home/hond-home-inn-spring.png")}
      alt={t.alt}
      width="1600"
      height="1000"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="home-house-welcome" aria-hidden="true">
    <h1>{t.title}</h1>
    <p>{t.lead}</p>
  </div>

  <a class="house-hotspot hotspot-open-table" href={withBase(t.links.openTable)} data-tooltip={t.openTable}></a>

  <a class="house-hotspot hotspot-words" href={withBase(t.links.words)} data-tooltip={t.words}></a>

  <a class="house-hotspot hotspot-contact" href={withBase(t.links.contact)} data-tooltip={t.contact}></a>

  <a class="house-hotspot hotspot-newsletter" href={withBase(t.links.newsletter)} data-tooltip={t.newsletter}></a>

  <a class="house-hotspot hotspot-about" href={withBase(t.links.about)} data-tooltip={t.about}></a>

  <a class="house-hotspot hotspot-traces" href={withBase(t.links.traces)} data-tooltip={t.traces}></a>

  <div class="house-hotspot hotspot-meditation is-disabled" data-tooltip={`${t.meditation} · ${t.soon}`}></div>
</section>

<div class="house-cursor-tooltip" aria-hidden="true"></div>

<section class="home-house-links" aria-label={lang === "nl" ? "Kamers van het Huis" : "Rooms of the House"}>
  <a href={withBase(t.links.openTable)}>{t.openTable}</a>
  <a href={withBase(t.links.words)}>{t.words}</a>
  <a href={withBase(t.links.contact)}>{t.contact}</a>
  <a href={withBase(t.links.newsletter)}>{t.newsletter}</a>
  <a href={withBase(t.links.about)}>{t.about}</a>
  <a href={withBase(t.links.traces)}>{t.traces}</a>
  <span>{t.meditation} · {t.soon}</span>
</section>

<script>
  const homeHouse = document.querySelector<HTMLElement>(".home-house");
  const tooltip = document.querySelector<HTMLElement>(".house-cursor-tooltip");

  if (homeHouse && tooltip) {
    const hotspots = homeHouse.querySelectorAll<HTMLElement>("[data-tooltip]");

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener("mouseenter", () => {
        tooltip.textContent = hotspot.dataset.tooltip || "";
        tooltip.classList.add("is-visible");
      });

      hotspot.addEventListener("mousemove", (event: MouseEvent) => {
        tooltip.style.left = `${event.clientX}px`;
        tooltip.style.top = `${event.clientY}px`;
      });

      hotspot.addEventListener("mouseleave", () => {
        tooltip.classList.remove("is-visible");
      });

      hotspot.addEventListener("focus", () => {
        tooltip.textContent = hotspot.dataset.tooltip || "";
        tooltip.classList.add("is-visible");
      });

      hotspot.addEventListener("blur", () => {
        tooltip.classList.remove("is-visible");
      });
    });
  }
</script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const homeHouse = document.querySelector(".home-house");
    if (!homeHouse) return;

    const image = homeHouse.querySelector("img");
    if (!image) {
      homeHouse.classList.add("is-loaded");
      return;
    }

    if (image.complete) {
      homeHouse.classList.add("is-loaded");
      return;
    }

    image.addEventListener("load", function () {
      homeHouse.classList.add("is-loaded");
    });
  });
</script>