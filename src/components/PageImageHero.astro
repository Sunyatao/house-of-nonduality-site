---
interface Props {
  title: string;
  lead?: string;
  kicker?: string;
  imageSrc: string;
  imageAlt: string;
  fade?: boolean;
  showImageView?: boolean;
  imageViewLabel?: string;
  imageInfoLabel?: string;
}

const {
  title,
  lead,
  kicker,
  imageSrc,
  imageAlt,
  fade = true,
  showImageView = false,
  imageViewLabel = "View image",
  imageInfoLabel = "Show info",
} = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const imageAvif = imageSrc.replace(/\.(png|jpg|jpeg|webp)$/i, ".avif");
const imageWebp = imageSrc.replace(/\.(png|jpg|jpeg|avif)$/i, ".webp");
---

<section class:list={["page-image-hero", fade && "has-fading-title"]}>
  <picture>
    <source srcset={withBase(imageAvif)} type="image/avif" />
    <source srcset={withBase(imageWebp)} type="image/webp" />
    <img
      class="page-image-hero-image"
      src={withBase(imageSrc)}
      alt={imageAlt}
      width="1600"
      height="1000"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

{showImageView && (
  <button
    class="image-view-button"
    type="button"
    data-image-view-toggle
    data-view-label={imageViewLabel}
    data-info-label={imageInfoLabel}
    aria-pressed="false"
  >
    {imageViewLabel}
  </button>
)}

  <div class="page-image-hero-content">
    {kicker && <p class="page-image-hero-kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-image-hero-lead">{lead}</p>}
  </div>

  {Astro.slots.has("default") && (
    <div class="page-image-hero-body">
      <slot />
    </div>
  )}

</section>

<script is:inline>
  document.addEventListener("click", function (event) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest("[data-image-view-toggle]");
    if (!button) return;

    const hero = button.closest(".page-image-hero");
    if (!hero) return;

    const isViewingImage = hero.classList.toggle("is-viewing-image");

    button.setAttribute("aria-pressed", isViewingImage ? "true" : "false");

    const viewLabel = button.getAttribute("data-view-label") || "View image";
    const infoLabel = button.getAttribute("data-info-label") || "Show info";

    button.textContent = isViewingImage ? infoLabel : viewLabel;
  });
</script>