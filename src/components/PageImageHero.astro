---
interface Props {
  title: string;
  lead?: string;
  kicker?: string;
  imageSrc: string;
  imageAlt: string;
  fade?: boolean;
}

const {
  title,
  lead,
  kicker,
  imageSrc,
  imageAlt,
  fade = true,
} = Astro.props;
---

<section class:list={["page-image-hero", fade && "has-fading-title"]}>
  <picture>
    <source
      srcset={imageSrc.replace(/\.(png|jpg|jpeg|webp)$/i, ".avif")}
      type="image/avif"
    />
    <source
      srcset={imageSrc.replace(/\.(png|jpg|jpeg|avif)$/i, ".webp")}
      type="image/webp"
    />
    <img
      class="page-image-hero-image"
      src={imageSrc}
      alt={imageAlt}
      width="1600"
      height="1000"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="page-image-hero-content">
    {kicker && <p class="page-image-hero-kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-image-hero-lead">{lead}</p>}
  </div>

  {Astro.slots.has("default") && (
    <div class="page-image-hero-body">
      <slot />
    </div>
  )}
</section>