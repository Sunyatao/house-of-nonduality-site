---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AddToCalendar from "../../components/AddToCalendar.astro";
import { allEvents } from "../../data/events";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const upcomingEvents = allEvents.slice(0, 12);

const formatDate = (date: string) => {
  return new Intl.DateTimeFormat("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
};

const getEventLabel = (kind: string) => {
  if (kind === "open-table") return "Open Table";
  if (kind === "words-from-silence") return "Words from Silence";
  return "Gathering";
};
---

<BaseLayout
  title="Calendar — The House of Nonduality"
  description="All upcoming gatherings of The House of Nonduality in one overview."
  lang="en"
>
  <section class="hero agenda-hero">
    <p class="kicker">Upcoming gatherings</p>
    <h1>Calendar</h1>
    <p class="lead">
      An overview of the upcoming gatherings of The House of Nonduality:
      Open Table and Words from Silence.
    </p>
  </section>

  <section class="agenda-intro-section">
    <div class="agenda-intro-grid">
      <article class="card agenda-intro-card">
        <h2>Everything together</h2>
        <p>
          Here you can find the upcoming editions of Open Table and Words from
          Silence together in one overview.
        </p>
      </article>

      <article class="card agenda-intro-card">
        <h2>In your calendar</h2>
        <p>
          For each gathering, you can immediately add the date to Google
          Calendar, Apple Calendar, Outlook or another digital calendar.
        </p>
      </article>

      <article class="card agenda-intro-card">
        <h2>Joining</h2>
        <p>
          Would you like to join? Click through to the gathering itself or write
          through the contact page.
        </p>
      </article>
    </div>
  </section>

  <section class="agenda-list-section">
    <div class="agenda-list">
      {upcomingEvents.map((event) => (
        <article class="card agenda-event-card">
          <div class="agenda-event-meta">
            <span>{formatDate(event.date)}</span>
            <span>{event.startTime}–{event.endTime}</span>
          </div>

          <h2>{event.title.en}</h2>

          <p>{event.description.en}</p>

          <div class="agenda-event-actions">
            <a class="button" href={withBase(event.pagePath.en)}>
              More about {getEventLabel(event.kind)}
            </a>

            <AddToCalendar event={event} lang="en" />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>