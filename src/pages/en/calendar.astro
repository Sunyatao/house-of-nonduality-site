---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import AddToCalendar from "../../components/AddToCalendar.astro";
import { upcomingEvents, type CalendarEvent } from "../../data/events";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const formatMonth = (date: string) => {
  return new Intl.DateTimeFormat("en-GB", {
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
};

const formatEventDate = (date: string) => {
  return new Intl.DateTimeFormat("en-GB", {
    weekday: "short",
    day: "numeric",
    month: "long",
  }).format(new Date(`${date}T12:00:00`));
};

type MonthGroup = {
  key: string;
  label: string;
  events: CalendarEvent[];
};

const groupedEvents: MonthGroup[] = [];

for (const event of upcomingEvents) {
  const key = event.date.slice(0, 7);
  const existingGroup = groupedEvents.find((group) => group.key === key);

  if (existingGroup) {
    existingGroup.events.push(event);
  } else {
    groupedEvents.push({
      key,
      label: formatMonth(event.date),
      events: [event],
    });
  }
}
---

<BaseLayout
  title="Calendar — The House of Nonduality"
  description="All upcoming gatherings of The House of Nonduality in one clear overview."
  lang="en"
  image="/images/calendar/hond_agenda_scroll.png"
>
  <PageImageHero
    kicker="Upcoming gatherings"
    title="Calendar"
    lead="New gatherings will appear here as they take shape."
    imageSrc="/images/calendar/hond_agenda_scroll.png"
    imageAlt="A warm agenda scroll in The House of Nonduality, ready to show the upcoming gatherings."
    showImageView={true}
    imageViewLabel="View the scroll"
    imageInfoLabel="Show calendar"
  >
    <section class="agenda-scroll-wrap">
      <div class="agenda-scroll">
        <header class="agenda-scroll-header">
          <h2>
            {upcomingEvents.length > 0
              ? "Upcoming gatherings"
              : "No gatherings are currently scheduled"}
          </h2>
        </header>

        {upcomingEvents.length > 0 ? (
          <div class="agenda-months">
            {groupedEvents.map((group) => (
              <section class="agenda-month-block">
                <h3>{group.label}</h3>

                <ul class="agenda-month-list">
                  {group.events.map((event) => (
                    <li class="agenda-scroll-event">
                      <a
                        class="agenda-scroll-event-title"
                        href={withBase(event.pagePath.en)}
                      >
                        {event.title.en}
                      </a>

                      <p class="agenda-scroll-event-meta">
                        {formatEventDate(event.date)} · {event.startTime}–{event.endTime}
                      </p>

                      <AddToCalendar event={event} lang="en" />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <div class="agenda-empty">
            <p>
              There is currently no fixed programme. New talks, walks and other ways
              of gathering will be announced through the newsletter.
            </p>

            <a class="agenda-registration-link" href={withBase("/en/newsletter/")}>
              Subscribe to the newsletter
            </a>
          </div>
        )}
      </div>
    </section>
  </PageImageHero>
</BaseLayout>
