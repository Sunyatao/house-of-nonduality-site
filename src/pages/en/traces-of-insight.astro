---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;
const gardenUrl = "https://insight.houseofnonduality.com/";

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};
---

<BaseLayout
  title="Texts — The House of Nonduality"
  description="Texts, voices and insights around mysticism, contemplation, philosophy and nonduality."
  lang="en"
  image="/images/social/traces-of-insight-og.jpg"
>
  <PageImageHero
    kicker="Traces of insight"
    title="Texts"
    lead="A growing collection of essays, translations and reflections on nonduality, mysticism, philosophy and the question of what is real."
    imageSrc="/images/traces/hond-traces-of-insight-spring.png"
    imageAlt="A warm library in The House of Nonduality, with books, a writing desk, subtle growth from open books and a view of the mountains."
    showImageView={true}
    imageViewLabel="View the library"
    imageInfoLabel="Show text"
  >
    <section class="hero-card-grid traces-card-grid">
      <article class="hero-card traces-hero-card hero-card-large">
        <h2>Reading as inquiry</h2>
        <p>
          Here, the texts themselves are given a place. Each contribution can be
          read on its own, while also forming part of a wider inquiry into
          experience, consciousness, suffering, identity and what we truly are.
        </p>
      </article>

      <a
        class="hero-card traces-hero-card traces-featured-card"
        href={gardenUrl}
        aria-label="Explore the living Traces of Insight garden"
      >
        <p class="traces-card-label">Living garden · always growing</p>
        <h2>Open Traces of Insight</h2>
        <p>
          Explore the published notes from the Obsidian garden as an
          interconnected landscape of fragments, sources, people and timelines.
        </p>
        <span class="traces-card-themes">fragments · sources · connections</span>
        <span class="card-link">Explore the garden <span aria-hidden="true">↗</span></span>
      </a>

      <article class="hero-card traces-hero-card">
        <h2>What appears here</h2>
        <p>
          Fragments, translations, source notes, essays and reflections.
          Sometimes a trace begins with a poem or an old source, sometimes with
          a question arising in everyday life.
        </p>
      </article>

      <article class="hero-card traces-hero-card">
        <h2>A garden, not an archive</h2>
        <p>
          The notes grow in Obsidian and are woven together by Quartz. Only what
          is ready to be shared appears in the public garden.
        </p>
      </article>

      <article class="hero-card traces-hero-card hero-card-callout">
        <h2>Receive new texts</h2>
        <p>
          Through the newsletter, you will occasionally receive a new text, a
          poem or an invitation to a gathering.
        </p>
        <a class="button primary" href={withBase("/en/newsletter/")}>Go to the newsletter</a>
      </article>
    </section>
  </PageImageHero>
</BaseLayout>
