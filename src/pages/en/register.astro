---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Register — The House of Nonduality"
  description="Registration is not currently open for a gathering of The House of Nonduality."
  lang="en"
  image="/images/contact/hond-contact-writing-desk.png"
>
  <PageImageHero
    kicker="Gatherings"
    title="Register"
    lead="There is currently no gathering open for registration."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="A writing desk with a blank letter, pen, cup and dove in The House of Nonduality."
    showImageView={true}
    imageViewLabel="View the table"
    imageInfoLabel="Show information"
  >
    <section class="hero-card-grid">
      <article class="hero-card hero-card-callout">
        <h2>Stay informed</h2>
        <p>
          New talks, walks and other ways of gathering will be announced through
          the newsletter. Once a concrete gathering is planned, registration will
          become available here again.
        </p>

        <div class="hero-card-actions">
          <a class="button primary" href={`${base}en/newsletter/`}>
            Newsletter
          </a>
          <a class="button" href={`${base}en/contact/`}>
            Contact
          </a>
        </div>
      </article>
    </section>
  </PageImageHero>
</BaseLayout>
