---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import { allEvents, type CalendarEvent } from "../../data/events";
import FormspreeAjax from "../../components/FormspreeAjax.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const targetYear = 2026;

const registrationEvents = allEvents.filter((event) =>
  event.date.startsWith(`${targetYear}-`),
);

const formatEventOption = (event: CalendarEvent) => {
  const date = new Intl.DateTimeFormat("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${event.date}T12:00:00`));

  return `${event.title.en} — ${date} · ${event.startTime}–${event.endTime}`;
};
---

<BaseLayout
  title="Register — The House of Nonduality"
  description="Register for one or more gatherings of The House of Nonduality."
  lang="en"
  image="/images/contact/hond-contact-writing-desk.png"

>
  <PageImageHero
    kicker="Welcome"
    title="Register"
    lead="Would you like to join a gathering? Fill in your details below. I will confirm your registration by email afterwards."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="A writing desk with a blank letter, pen, cup and dove in The House of Nonduality."
    showImageView={true}
    imageViewLabel="View the table"
    imageInfoLabel="Show form"
  >
    <section class="contact-paper-form-wrap registration-paper-form-wrap">
      <form
        class="contact-paper-form registration-paper-form"
        action="https://formspree.io/f/xzdwoede"
        method="post"
        data-formspree-ajax
        data-success-url={withBase("/bedankt/")}
        data-required-checkbox-name="gatherings"
        data-checkbox-error="Duid minstens één bijeenkomst aan."
        data-loading-label="Inschrijving versturen..."
        data-error-label="Er ging iets mis. Probeer het opnieuw of schrijf rechtstreeks naar contact@houseofnonduality.com."
        >
        <label>
          <span>Name *</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>

        <label>
          <span>Email address *</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <fieldset class="registration-checkbox-group">
  <legend>Gatherings *</legend>

  <div class="registration-checkbox-list">
    {registrationEvents.map((event) => (
      <label class="registration-checkbox-item">
        <input
          type="checkbox"
          name="gatherings"
          value={formatEventOption(event)}
        />
        <span>{formatEventOption(event)}</span>
      </label>
    ))}
  </div>

  <p class="registration-checkbox-note">
    You can select one or more gatherings.
  </p>
</fieldset>

        <label>
          <span>Number of people *</span>
          <input
            type="number"
            name="number_of_people"
            min="1"
            max="10"
            value="1"
            required
          />
        </label>

        <label>
          <span>Message or note</span>
          <textarea
            name="message"
            rows="4"
            placeholder="You can leave a note here if needed."
          ></textarea>
        </label>

        <input
          type="hidden"
          name="subject"
          value="New registration through The House of Nonduality"
        />

        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          style="position: absolute; left: -5000px;"
        />

        <button class="button primary contact-submit-button" type="submit">
          Send registration
        </button>

        <p class="contact-direct-note">
          Your registration is only confirmed once you have received a reply.
        </p>
      </form>
    </section>
  </PageImageHero>
<FormspreeAjax />
</BaseLayout>