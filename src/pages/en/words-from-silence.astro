---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const archiveUrl = "https://insight.houseofnonduality.com/woorden-uit-de-stilte/overzicht-woorden-uit-de-stilte";
---

<BaseLayout
  title="Words from Silence — The House of Nonduality"
  description="Words from Silence is a quiet gathering in Leuven with poetry, short texts, silence and reflection around mysticism, contemplation and nonduality."
  lang="en"
  image="/images/social/words-from-silence-og.jpg"
>
  <PageImageHero
    kicker="Poetry · silence · reflection"
    title="Words from Silence"
    lead="A quiet evening with poetry, short texts, silence and reflection around mysticism, contemplation and nonduality."
    imageSrc="/images/words/hond-words-from-silence-spring.png"
    imageAlt="A warm quiet reading room in The House of Nonduality, with an open book, an armchair, candlelight and soft afternoon sun."
  >
    <div class="words-room-layer" aria-label="Interactive Words from Silence room">
      <a
        class="words-room-hotspot words-room-hotspot-book"
        href={archiveUrl}
        aria-label="Open the gathered evenings"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Gathered evenings</span>
      </a>

      <button
        class="words-room-hotspot words-room-hotspot-chair"
        type="button"
        data-words-room-toggle
        aria-controls="words-room-info-en"
        aria-expanded="false"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Practical info</span>
      </button>

      <a
        class="words-room-hotspot words-room-hotspot-traces"
        href={withBase("/en/traces-of-insight/")}
        aria-label="Open Traces of Insight"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Traces of Insight</span>
      </a>

      <a
        class="words-room-hotspot words-room-hotspot-entrance"
        href={withBase("/en/")}
        aria-label="Return to the entrance hall"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Entrance hall</span>
      </a>

      <section
        id="words-room-info-en"
        class="words-room-panel"
        aria-label="Words from Silence practical information"
        hidden
      >
        <div class="words-room-panel-inner">
          <button
            class="words-room-panel-close"
            type="button"
            data-words-room-close
            aria-controls="words-room-info-en"
          >
            Close
          </button>

          <section class="hero-card-grid words-hero-grid words-all-cards">
            <article class="hero-card words-hero-card hero-card-large">
              <h2>What is it?</h2>
              <p>
                <em>Words from Silence</em> began as a series of quiet evenings with
                poetry, short texts, silence and reflection around mysticism,
                contemplation and nonduality. This form may return, but no longer on
                a fixed monthly rhythm.
              </p>
            </article>

            <article class="hero-card words-hero-card">
              <h2>What do we read?</h2>
              <p>
                We read texts from different mystical, poetic and contemplative
                traditions: poems, short fragments and quotations that invite slowing
                down, attention and inner silence.
              </p>
            </article>

            <article class="hero-card words-hero-card">
              <h2>What can you expect?</h2>
              <p>
                The evening consists of a simple alternation of text, silence and
                conversation. Sometimes there is a short introduction, sometimes a
                brief exchange, sometimes mostly silence.
              </p>
            </article>

            <article class="hero-card words-hero-card words-compact-card">
              <h2>Practical</h2>
              <ul class="detail-meta-list">
                <li>No fixed rhythm</li>
                <li>The date, time and location will be announced for each gathering</li>
                <li>Dutch and English, depending on the texts and who is present</li>
              </ul>
            </article>

            <article class="hero-card words-hero-card words-compact-card">
              <h2>Next gathering</h2>
              <p>There is currently no new evening scheduled.</p>
            </article>

            <article class="hero-card words-hero-card words-archive-card">
              <h2>Gathered evenings</h2>
              <p>
                Explore the gathered evenings, fragments, images and source notes.
              </p>
              <div class="hero-card-actions">
                <a class="button" href={archiveUrl}>
                  Open the gathered evenings
                </a>
              </div>
            </article>

            <article class="hero-card words-hero-card hero-card-callout">
              <h2>Would you like to know when this form returns?</h2>
              <p>
                New gatherings will be announced through the newsletter.
              </p>
              <div class="hero-card-actions">
                <a class="button primary" href={withBase("/en/newsletter/")}>
                  Stay informed
                </a>
                <a class="button" href={withBase("/en/contact/")}>
                  Contact
                </a>
              </div>
            </article>
          </section>
        </div>
      </section>
    </div>
  </PageImageHero>
  <nav class="words-room-mobile-menu" aria-label="Words from Silence navigation">
  <a href={archiveUrl}>Gathered evenings</a>

  <button
    type="button"
    data-words-room-toggle
    aria-controls="words-room-info-en"
    aria-expanded="false"
  >
    Practical info
  </button>

  <a href={withBase("/en/traces-of-insight/")}>Traces of Insight</a>
  <a href={withBase("/en/")}>Entrance hall</a>
</nav>
</BaseLayout>

<script>
  const setWordsRoomPanel = (panel: HTMLElement, open: boolean) => {
    panel.hidden = !open;
    panel.classList.toggle("is-open", open);

    const hero = panel.closest(".page-image-hero");
    hero?.classList.toggle("words-room-panel-open", open);

    const toggle = hero?.querySelector<HTMLElement>(`[data-words-room-toggle][aria-controls="${panel.id}"]`);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");

    if (open) {
      panel.querySelector<HTMLElement>("[data-words-room-close]")?.focus({ preventScroll: true });
    }
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const toggle = target.closest<HTMLElement>("[data-words-room-toggle]");
    if (toggle) {
      const panelId = toggle.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (panel) {
        setWordsRoomPanel(panel, panel.hasAttribute("hidden"));
      }
      return;
    }

    const close = target.closest<HTMLElement>("[data-words-room-close]");
    if (close) {
      const panelId = close.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : close.closest<HTMLElement>(".words-room-panel");
      if (panel) {
        setWordsRoomPanel(panel, false);
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    document.querySelectorAll<HTMLElement>(".words-room-panel.is-open").forEach((panel) => {
      setWordsRoomPanel(panel, false);
    });
  });
</script>
