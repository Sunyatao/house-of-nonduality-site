---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHouseMap from "../../components/HomeHouseMap.astro";
---

<BaseLayout
  title="House of Nonduality"
  description="A space for silence, poetry and contemplative encounter in Leuven."
  lang="en"
>
  <section class="home-intro">
    <p class="kicker">Leuven · silence · encounter</p>
    <h1>House of Nonduality</h1>
    <div class="ornament-line" aria-hidden="true"><span>☉</span></div>
    <p class="lead">
      A space where poetry, philosophy and contemplation meet around one simple question:
      what remains when we become still?
    </p>
  </section>

<HomeHouseMap lang="en" />
</BaseLayout>