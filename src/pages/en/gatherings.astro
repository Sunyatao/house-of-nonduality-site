---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Gatherings — The House of Nonduality"
  description="Gatherings around silence, contemplation, text, food and encounter in Leuven."
  lang="en"
>
  <PageImageHero
    title="Gatherings"
    lead="Recurring ways of gathering around silence, contemplation, text, food and encounter in Leuven."
    imageSrc="/images/home/hond-home-inn-spring.png"
    imageAlt="A warm inn with rooms for encounter, silence, contact, meditation and study."
  >
    <section class="hero-card-grid gatherings-card-grid">
      <article class="hero-card gatherings-intro-card">
        <h2>Ways of gathering</h2>
        <p>
          The House of Nonduality takes shape through simple gatherings:
          a table, a text, a silence, a conversation. Not as a fixed doctrine,
          but as an invitation to slow down together and look more attentively.
        </p>
      </article>

      <a class="hero-card hero-card-open-table" href={`${base}en/open-table/`}>
        <span class="hero-card-arrow hero-card-arrow-left" aria-hidden="true">←</span>
        <h2>Open Table</h2>
        <p>
          A simple gathering around plant-based food, silence, a walk and
          conversation.
        </p>
        <span class="card-link">Read more</span>
      </a>

     <a class="hero-card hero-card-agenda" href={`${base}en/calendar/`}>
        <h2>Calendar</h2>
        <p>
          All upcoming gatherings in one overview, with the option to add them
          directly to your own digital calendar.
        </p>
        <span class="card-link">View calendar</span>
      </a>

      <a class="hero-card hero-card-words" href={`${base}en/words-from-silence/`}>
        <span class="hero-card-arrow hero-card-arrow-right" aria-hidden="true">→</span>
        <h2>Words from Silence</h2>
        <p>
          An evening with mystical poetry and short texts, alternated with
          silence and conversation.
        </p>
        <span class="card-link">Read more</span>
      </a>
      
    </section>
  </PageImageHero>
</BaseLayout>