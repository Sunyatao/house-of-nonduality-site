---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Gatherings — The House of Nonduality"
  description="Small gatherings around silence, contemplation, encounter, and the question of what is real."
  lang="en"
>
  <PageImageHero
    title="Gatherings"
    lead="Small ways of coming together around silence, contemplation, encounter, and the question of what is real."
    imageSrc="/images/home/hond-home-inn-spring.png"
    imageAlt="A warm house with rooms for encounter, silence, contact, meditation and study."
    showImageView={true}
    imageViewLabel="View house"
    imageInfoLabel="Show text"
  >
    <section class="hero-card-grid gatherings-card-grid">
      <article class="hero-card gatherings-intro-card">
        <h2>Living encounter</h2>
        <p>
          The House of Nonduality takes shape not only through texts and digital
          rooms, but also through living encounter: eating together, listening,
          reading, speaking, being silent, and exploring what is real.
        </p>
        <p>
          The gatherings are simple and small-scale. They require no prior
          knowledge, belief, or spiritual identity. They are intended as open
          spaces for slowing down, contemplation, and encounter.
        </p>
      </article>

      <a class="hero-card hero-card-open-table" href={`${base}en/open-table/`}>
        <span class="hero-card-arrow hero-card-arrow-left" aria-hidden="true">←</span>
        <h2>Open Table</h2>
        <p>
          A simple gathering around food, silence, walking, and conversation.
          We gather around the table, share a meal, and leave space for what
          naturally arises.
        </p>
        <span class="card-link">Read more</span>
      </a>

      <a class="hero-card hero-card-words" href={`${base}en/words-from-silence/`}>
        <span class="hero-card-arrow hero-card-arrow-right" aria-hidden="true">→</span>
        <h2>Words from Silence</h2>
        <p>
          A quiet evening with poetry, short texts, silence, and reflection
          around mysticism, contemplation, and nonduality. Not as a lecture,
          but as a shared listening space.
        </p>
        <span class="card-link">Read more</span>
      </a>
    </section>
  </PageImageHero>
</BaseLayout>