---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
---

<BaseLayout
  title="Gatherings — House of Nonduality"
  description="Gatherings around silence, poetry, contemplation and encounter in Leuven."
  lang="en"
>
  <PageImageHero
    title="Gatherings"
    lead="Two recurring forms of gathering: an evening with poetry and contemplative texts, and a simple table around food, conversation and presence."
    imageSrc="/images/home/hond-home-inn-spring.png"
    imageAlt="A warm inn with rooms for gathering, silence, contact, meditation and study."
  >
  <section class="hero-card-grid">
  <a class="hero-card hero-card-open-table" href="/en/open-table/">
    <span class="hero-card-arrow hero-card-arrow-left" aria-hidden="true">←</span>
    <h2>Open Table</h2>
    <p>
      A simple gathering around plant-based food, silence, walking and conversation.
    </p>
    <span class="card-link">Read more</span>
  </a>

  <a class="hero-card hero-card-words" href="/en/words-from-silence/">
    <span class="hero-card-arrow hero-card-arrow-right" aria-hidden="true">→</span>
    <h2>Words from Silence</h2>
    <p>
      An evening with mystical poetry and short texts, interwoven with silence and conversation.
    </p>
    <span class="card-link">Read more</span>
  </a>
</section>
 </PageImageHero>
</BaseLayout>