---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
---

<BaseLayout
  title="Contact — The House of Nonduality"
  description="Contact The House of Nonduality for questions, gatherings, collaborations, or anything related to silence, encounter and nonduality."
  lang="en"
>
  <PageImageHero
    kicker="Write to me"
    title="Contact"
    lead="Have a question, want to join a gathering, or feel moved to share something? You are always welcome to write."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="A writing desk with a blank letter, pen, cup and stationery in The House of Nonduality."
    showImageView={true}
    imageViewLabel="View table"
    imageInfoLabel="Show text"
  >
    <section class="contact-paper-form-wrap">
      <form
        class="contact-paper-form"
        action="https://formspree.io/f/xzdwoede"
        method="post"
      >
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" />
        </label>

        <label>
          <span>Email address</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <input
          type="hidden"
          name="subject"
          value="New message via The House of Nonduality"
        />

        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          style="position: absolute; left: -5000px;"
        />

        <button class="button primary contact-submit-button" type="submit">
          Send
        </button>

        <p class="contact-direct-note">
          Or write directly to
          <a href="mailto:contact@houseofnonduality.com">
            contact@houseofnonduality.com
          </a>
        </p>
      </form>
    </section>
  </PageImageHero>
</BaseLayout>