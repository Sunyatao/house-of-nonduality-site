---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import FormspreeAjax from "../../components/FormspreeAjax.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

---

<BaseLayout
  title="Contact — The House of Nonduality"
  description="Contact The House of Nonduality for questions, participation in gatherings, or collaborations around silence, encounter and nonduality."
  lang="en"
  image="/images/contact/hond-contact-writing-desk.png"
>
  <PageImageHero
    kicker="Write to me"
    title="Contact"
    lead="Do you have a question, would you like to join a gathering, or is there something you would like to share? You are always welcome to write."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="A writing desk with an empty letter, pen, cup and dove in The House of Nonduality."
    showImageView={true}
    imageViewLabel="View the desk"
    imageInfoLabel="Show text"
  >
    <section class="contact-paper-form-wrap">
      <form
      class="contact-paper-form registration-paper-form"
      action="https://formspree.io/f/xzdwoede"
      method="post"
      data-formspree-ajax
      data-success-url={withBase("/bedankt/")}
      data-error-label="Er ging iets mis. Probeer het opnieuw of schrijf rechtstreeks naar contact@houseofnonduality.com."
      >
        <label>
          <span>Name *</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>

        <label>
          <span>Email address *</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label>
          <span>Message *</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <input
          type="hidden"
          name="subject"
          value="New message through The House of Nonduality"
        />

        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          style="position: absolute; left: -5000px;"
        />

        <button class="button primary contact-submit-button" type="submit">
          Send
        </button>

        <p class="contact-direct-note">
          Or write directly to
          <a href="mailto:contact@houseofnonduality.com">
            contact@houseofnonduality.com
          </a>
        </p>
      </form>
    </section>
  </PageImageHero>
  <FormspreeAjax />
</BaseLayout>