---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
---

<BaseLayout
  title="Newsletter — The House of Nonduality"
  description="Subscribe to the newsletter of The House of Nonduality: an occasional letter, text, poem, or invitation to an upcoming gathering."
  lang="en"
  image="/images/newsletter/hond-newsletter-writing-nook.png"
>
  <PageImageHero
    kicker="Letters from the House"
    title="Newsletter"
    lead="An occasional letter from The House of Nonduality: a text, a poem, or an invitation to an upcoming gathering."
    imageSrc="/images/newsletter/hond-newsletter-writing-nook.png"
    imageAlt="A warm writing desk with letters, a small wall cabinet and a dove in The House of Nonduality."
    showImageView={true}
    imageViewLabel="View the room"
    imageInfoLabel="Show text"
  >
    <section class="hero-card-grid newsletter-card-grid">
      <article class="hero-card">
        <h2>Stay connected</h2>
        <p>
          Through the newsletter, you will occasionally receive a short text,
          a poem, or an invitation to a gathering around silence, encounter,
          contemplation and nonduality.
        </p>
      </article>

      <article class="hero-card">
        <h2>A quiet rhythm</h2>
        <p>
          No crowded inbox and no constant stream of messages. Only when there
          is something truly worth sharing: an upcoming evening, a new text,
          or a small letter from silence.
        </p>
      </article>

      <article class="hero-card newsletter-signup-card">
        <h2>Subscribe</h2>

        <form
          class="newsletter-form"
          action="https://gmail.us2.list-manage.com/subscribe/post?u=c41c3b77d5559a09a348d05f0&amp;id=6ecb88e329&amp;f_id=002dc6e1f0"
          method="post"
          target="_blank"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
        >
          <label for="mce-EMAIL">
            <span>Email address *</span>
            <input
              type="email"
              name="EMAIL"
              id="mce-EMAIL"
              autocomplete="email"
              required
            />
          </label>

          <label for="mce-FNAME">
            <span>Name</span>
            <input
              type="text"
              name="FNAME"
              id="mce-FNAME"
              autocomplete="name"
            />
          </label>

          <label for="mce-MMERGE7">
            <span>Language *</span>
            <select name="MMERGE7" id="mce-MMERGE7" required>
              <option value="">Choose a language</option>
              <option value="Nederlands">Nederlands</option>
              <option value="English">English</option>
            </select>
          </label>

          <div aria-hidden="true" style="position: absolute; left: -5000px;">
            <input
              type="text"
              name="b_c41c3b77d5559a09a348d05f0_6ecb88e329"
              tabindex="-1"
              value=""
            />
          </div>

          <button
            class="button primary newsletter-submit-button"
            type="submit"
            name="subscribe"
            id="mc-embedded-subscribe"
          >
            Subscribe
          </button>

          <p class="newsletter-privacy-note">
            You can unsubscribe at any time. Your information will only be used
            to send you the newsletter of The House of Nonduality.
          </p>
        </form>
      </article>
    </section>
  </PageImageHero>
</BaseLayout>