---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};
---

<BaseLayout
  title="The House of Nonduality"
  description="Kies je ingang tot The House of Nonduality. Choose your entrance into The House of Nonduality."
  hideHeader={true}
  image="/images/social/house-of-nonduality-og-1200x630.jpg"
>
  <section class="language-landing">
    <picture class="language-landing-picture">
    <source srcset={withBase("/images/home/hond-home-inn-spring.avif")} type="image/avif" />
    <source srcset={withBase("/images/home/hond-home-inn-spring.webp")} type="image/webp" />
    <img
      src={withBase("/images/home/hond-home-inn-spring.png")}
      alt=""
      width="1600"
      height="1000"
      loading="eager"
      decoding="async"
      fetchpriority="high"
/>
</picture>
    <div class="language-landing-overlay"></div>

    <div class="language-landing-card">
      <p class="language-landing-kicker">Welcome · Welkom</p>

     <h1>The House of Nonduality</h1>
     <h2>Het Huis van Nondualiteit</h2>

<p class="language-landing-lead">
  Choose your language · Kies je taal
</p>

<div class="language-landing-actions" data-language-actions>
<a href={withBase("/en/")} class="button primary" data-lang-option="en">English</a>
<a href={withBase("/nl/")} class="button" data-lang-option="nl">Nederlands</a>
</div>
    </div>
  </section>

  <script>
  const preferredLanguage = navigator.language || navigator.languages?.[0] || "";
  const actions = document.querySelector("[data-language-actions]");

  if (actions && preferredLanguage.toLowerCase().startsWith("nl")) {
    const nlButton = actions.querySelector('[data-lang-option="nl"]');
    const enButton = actions.querySelector('[data-lang-option="en"]');

    if (nlButton && enButton) {
      actions.prepend(nlButton);
      nlButton.classList.add("primary");
      enButton.classList.remove("primary");
    }
  }
</script>

</BaseLayout>