---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageImageHero from "../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};
---

<BaseLayout
  title="404 — The House of Nonduality"
  description="Deze kamer bestaat niet. This room does not exist."
  lang="nl"
  hideHeader={true}
>
  <PageImageHero
    kicker="404"
    title="Deze kamer bestaat niet"
    lead="Misschien is de deur verplaatst, of was dit nooit een kamer van het huis."
    imageSrc="/images/404/hond-room-not-found.png"
    imageAlt="Een warme kamer in Het Huis van Nondualiteit met een open deur die uitkomt op een zachte, onbestemde leegte."
    showImageView={false}
  >
    <section class="not-found-wall-text" aria-labelledby="not-found-title">
      <div class="not-found-language-block">
        <p class="not-found-kicker">404</p>

        <h1 id="not-found-title">Deze kamer bestaat niet</h1>

        <p>
          Misschien is de deur verplaatst, of was dit nooit een kamer van het huis.
        </p>

        <div class="not-found-actions">
          <a class="button primary" href={withBase("/nl/")}>
            Naar de homepage
          </a>

          <a class="button" href={withBase("/nl/agenda/")}>
            Naar de agenda
          </a>
        </div>
      </div>

      <div class="not-found-language-block not-found-language-block-secondary">
        <h2>This room does not exist</h2>

        <p>
          Perhaps the door has moved, or perhaps this was never a room of the house.
        </p>

        <div class="not-found-actions">
          <a class="button primary" href={withBase("/en/")}>
            Go home
          </a>

          <a class="button" href={withBase("/en/calendar/")}>
            View calendar
          </a>
        </div>
      </div>
    </section>
  </PageImageHero>
</BaseLayout>