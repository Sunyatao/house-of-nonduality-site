---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import { allEvents, type CalendarEvent } from "../../data/events";

const targetYear = 2026;

const registrationEvents = allEvents.filter((event) =>
  event.date.startsWith(`${targetYear}-`),
);

const formatEventOption = (event: CalendarEvent) => {
  const date = new Intl.DateTimeFormat("nl-BE", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${event.date}T12:00:00`));

  return `${event.title.nl} — ${date} · ${event.startTime}–${event.endTime}`;
};
---

<BaseLayout
  title="Inschrijven — Het Huis van Nondualiteit"
  description="Schrijf je in voor een bijeenkomst van Het Huis van Nondualiteit in Leuven."
  lang="nl"
>
  <PageImageHero
    kicker="Welkom"
    title="Inschrijven"
    lead="Wil je deelnemen aan een bijeenkomst? Vul hieronder je gegevens in. Ik bevestig je inschrijving nadien per mail."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="Een schrijftafel met een lege brief, pen, kopje en duif in het Huis van Nondualiteit."
    showImageView={true}
    imageViewLabel="Bekijk de tafel"
    imageInfoLabel="Toon formulier"
  >
    <section class="contact-paper-form-wrap registration-paper-form-wrap">
      <form
        class="contact-paper-form registration-paper-form"
        action="https://formspree.io/f/xzdwoede"
        method="post"
      >
        <label>
          <span>Naam *</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>

        <label>
          <span>E-mailadres *</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <fieldset class="registration-checkbox-group">
  <legend>Bijeenkomsten *</legend>

  <div class="registration-checkbox-list">
    {registrationEvents.map((event) => (
      <label class="registration-checkbox-item">
        <input
          type="checkbox"
          name="gatherings"
          value={formatEventOption(event)}
        />
        <span>{formatEventOption(event)}</span>
      </label>
    ))}
  </div>

  <p class="registration-checkbox-note">
    Je kan één of meerdere bijeenkomsten aanvinken.
  </p>
</fieldset>

        <label>
          <span>Aantal personen *</span>
          <input
            type="number"
            name="number_of_people"
            min="1"
            max="10"
            value="1"
            required
          />
        </label>

        <label>
          <span>Bericht of opmerking</span>
          <textarea
            name="message"
            rows="4"
            placeholder="Laat hier eventueel iets weten."
          ></textarea>
        </label>

        <input
          type="hidden"
          name="subject"
          value="Nieuwe inschrijving via Het Huis van Nondualiteit"
        />

        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          style="position: absolute; left: -5000px;"
        />

        <button class="button primary contact-submit-button" type="submit">
          Inschrijving versturen
        </button>

        <p class="contact-direct-note">
          Je inschrijving is pas bevestigd wanneer je een antwoord hebt ontvangen.
        </p>
      </form>
    </section>
  </PageImageHero>
<script is:inline>
  const registrationForm = document.querySelector(".registration-paper-form");

  if (registrationForm) {
    registrationForm.addEventListener("submit", function (event) {
      const checkedGatherings = registrationForm.querySelectorAll(
        'input[name="gatherings"]:checked'
      );

      if (checkedGatherings.length === 0) {
        event.preventDefault();
        alert("Duid minstens één bijeenkomst aan.");
      }
    });
  }
</script>

</BaseLayout>