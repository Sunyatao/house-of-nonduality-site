---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Inschrijven — Het Huis van Nondualiteit"
  description="Er staat momenteel geen inschrijving open voor een bijeenkomst van Het Huis van Nondualiteit."
  lang="nl"
  image="/images/contact/hond-contact-writing-desk.png"
>
  <PageImageHero
    kicker="Bijeenkomsten"
    title="Inschrijven"
    lead="Er staat momenteel geen bijeenkomst open voor inschrijving."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="Een schrijftafel met een lege brief, pen, kopje en duif in het Huis van Nondualiteit."
    showImageView={true}
    imageViewLabel="Bekijk de tafel"
    imageInfoLabel="Toon informatie"
  >
    <section class="hero-card-grid">
      <article class="hero-card hero-card-callout">
        <h2>Blijf op de hoogte</h2>
        <p>
          Nieuwe lezingen, wandelingen en andere vormen van samenkomen worden
          aangekondigd via de nieuwsbrief. Zodra er een concrete bijeenkomst is,
          verschijnt hier opnieuw de mogelijkheid om je in te schrijven.
        </p>

        <div class="hero-card-actions">
          <a class="button primary" href={`${base}nl/nieuwsbrief/`}>
            Nieuwsbrief
          </a>
          <a class="button" href={`${base}nl/contact/`}>
            Contact
          </a>
        </div>
      </article>
    </section>
  </PageImageHero>
</BaseLayout>
