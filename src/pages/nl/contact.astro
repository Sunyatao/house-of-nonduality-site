---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import FormspreeAjax from "../../components/FormspreeAjax.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

---

<BaseLayout
  title="Contact — Het Huis van Nondualiteit"
  description="Neem contact op met Het Huis van Nondualiteit voor vragen, deelname aan bijeenkomsten of samenwerking."
  lang="nl"
  image="/images/contact/hond-contact-writing-desk.png"

>
  <PageImageHero
    kicker="Schrijf me"
    title="Contact"
    lead="Heb je een vraag, wil je deelnemen aan een bijeenkomst, of wil je iets delen? Je mag altijd schrijven."
    imageSrc="/images/contact/hond-contact-writing-desk.png"
    imageAlt="Een schrijftafel met een lege brief, pen, kopje en duif in het Huis van Nondualiteit."
    showImageView={true}
    imageViewLabel="Bekijk de tafel"
    imageInfoLabel="Toon tekst"
  >
    <section class="contact-paper-form-wrap">
      <form
      class="contact-paper-form registration-paper-form"
      action="https://formspree.io/f/xzdwoede"
      method="post"
      data-formspree-ajax
      data-success-url={withBase("/bedankt/")}
      data-error-label="Er ging iets mis. Probeer het opnieuw of schrijf rechtstreeks naar contact@houseofnonduality.com."
      >
        <label>
          <span>Naam *</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>

        <label>
          <span>E-mailadres *</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>

        <label>
          <span>Bericht *</span>
          <textarea name="message" rows="5" required></textarea>
        </label>

        <input
          type="hidden"
          name="subject"
          value="Nieuw bericht via Het Huis van Nondualiteit"
        />

        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          style="position: absolute; left: -5000px;"
        />

        <button class="button primary contact-submit-button" type="submit">
          Versturen
        </button>

        <p class="contact-direct-note">
          Of schrijf rechtstreeks naar
          <a href="mailto:contact@houseofnonduality.com">
            contact@houseofnonduality.com
          </a>
        </p>
      </form>
    </section>
  </PageImageHero>
  <FormspreeAjax />
</BaseLayout>