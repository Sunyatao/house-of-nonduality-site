---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AddToCalendar from "../../components/AddToCalendar.astro";
import { allEvents } from "../../data/events";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const upcomingEvents = allEvents.slice(0, 12);

const formatDate = (date: string) => {
  return new Intl.DateTimeFormat("nl-BE", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
};

const getEventLabel = (kind: string) => {
  if (kind === "open-table") return "Open Tafel";
  if (kind === "words-from-silence") return "Woorden uit de Stilte";
  return "Bijeenkomst";
};
---

<BaseLayout
  title="Agenda — Het Huis van Nondualiteit"
  description="Alle komende bijeenkomsten van Het Huis van Nondualiteit in één overzicht."
  lang="nl"
>
  <section class="hero agenda-hero">
    <p class="kicker">Komende bijeenkomsten</p>
    <h1>Agenda</h1>
    <p class="lead">
      Een overzicht van de komende bijeenkomsten van Het Huis van Nondualiteit:
      Open Tafel en Woorden uit de Stilte.
    </p>
  </section>

  <section class="agenda-intro-section">
    <div class="agenda-intro-grid">
      <article class="card agenda-intro-card">
        <h2>Alles samen</h2>
        <p>
          Hier vind je de komende edities van Open Tafel en Woorden uit de
          Stilte samen in één overzicht.
        </p>
      </article>

      <article class="card agenda-intro-card">
        <h2>In je agenda</h2>
        <p>
          Bij elke bijeenkomst kan je de datum meteen toevoegen aan Google
          Calendar, Apple Calendar, Outlook of een andere digitale agenda.
        </p>
      </article>

      <article class="card agenda-intro-card">
        <h2>Meedoen</h2>
        <p>
          Wil je deelnemen? Klik door naar de bijeenkomst zelf of schrijf via de
          contactpagina.
        </p>
      </article>
    </div>
  </section>

  <section class="agenda-list-section">
    <div class="agenda-list">
      {upcomingEvents.map((event) => (
        <article class="card agenda-event-card">
          <div class="agenda-event-meta">
            <span>{formatDate(event.date)}</span>
            <span>{event.startTime}–{event.endTime}</span>
          </div>

          <h2>{event.title.nl}</h2>

          <p>{event.description.nl}</p>

          <div class="agenda-event-actions">
            <a class="button" href={withBase(event.pagePath.nl)}>
              Meer info over {getEventLabel(event.kind)}
            </a>

            <AddToCalendar event={event} lang="nl" />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>