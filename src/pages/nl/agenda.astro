---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import AddToCalendar from "../../components/AddToCalendar.astro";
import { upcomingEvents, type CalendarEvent } from "../../data/events";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const formatMonth = (date: string) => {
  return new Intl.DateTimeFormat("nl-BE", {
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
};

const formatEventDate = (date: string) => {
  return new Intl.DateTimeFormat("nl-BE", {
    weekday: "short",
    day: "numeric",
    month: "long",
  }).format(new Date(`${date}T12:00:00`));
};

type MonthGroup = {
  key: string;
  label: string;
  events: CalendarEvent[];
};

const groupedEvents: MonthGroup[] = [];

for (const event of upcomingEvents) {
  const key = event.date.slice(0, 7);
  const existingGroup = groupedEvents.find((group) => group.key === key);

  if (existingGroup) {
    existingGroup.events.push(event);
  } else {
    groupedEvents.push({
      key,
      label: formatMonth(event.date),
      events: [event],
    });
  }
}
---

<BaseLayout
  title="Agenda — Het Huis van Nondualiteit"
  description="Alle komende bijeenkomsten van Het Huis van Nondualiteit in één helder overzicht."
  lang="nl"
  image="/images/calendar/hond_agenda_scroll.png"
>
  <PageImageHero
    kicker="Komende bijeenkomsten"
    title="Agenda"
    lead="Nieuwe bijeenkomsten verschijnen hier zodra ze vorm krijgen."
    imageSrc="/images/calendar/hond_agenda_scroll.png"
    imageAlt="Een warme agenda-rol in het Huis van Nondualiteit, klaar om de komende bijeenkomsten te tonen."
    showImageView={true}
    imageViewLabel="Bekijk de rol"
    imageInfoLabel="Toon agenda"
  >
    <section class="agenda-scroll-wrap">
      <div class="agenda-scroll">
        <header class="agenda-scroll-header">
          <h2>
            {upcomingEvents.length > 0
              ? "Komende bijeenkomsten"
              : "Momenteel geen bijeenkomsten gepland"}
          </h2>
        </header>

        {upcomingEvents.length > 0 ? (
          <div class="agenda-months">
            {groupedEvents.map((group) => (
              <section class="agenda-month-block">
                <h3>{group.label}</h3>

                <ul class="agenda-month-list">
                  {group.events.map((event) => (
                    <li class="agenda-scroll-event">
                      <a
                        class="agenda-scroll-event-title"
                        href={withBase(event.pagePath.nl)}
                      >
                        {event.title.nl}
                      </a>

                      <p class="agenda-scroll-event-meta">
                        {formatEventDate(event.date)} · {event.startTime}–{event.endTime}
                      </p>

                      <AddToCalendar event={event} lang="nl" />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <div class="agenda-empty">
            <p>
              Er staan momenteel geen vaste bijeenkomsten gepland. Nieuwe lezingen,
              wandelingen en andere vormen van samenkomen worden aangekondigd via de
              nieuwsbrief.
            </p>

            <a class="agenda-registration-link" href={withBase("/nl/nieuwsbrief/")}>
              Schrijf je in op de nieuwsbrief
            </a>
          </div>
        )}
      </div>
    </section>
  </PageImageHero>
</BaseLayout>
