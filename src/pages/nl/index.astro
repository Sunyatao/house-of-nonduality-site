---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHouseMap from "../../components/HomeHouseMap.astro";
---

<BaseLayout
  title="Het Huis van Nondualiteit"
  description="Een ruimte voor stilte, poëzie en contemplatieve ontmoeting in Leuven."
  lang="nl"
>
  <section class="home-intro">
    <p class="kicker">Leuven · stilte · ontmoeting</p>
    <h1>Het Huis van Nondualiteit</h1>
    <div class="ornament-line" aria-hidden="true"><span>☉</span></div>
    <p class="lead">
      Een ruimte waar poëzie, filosofie en contemplatie samenkomen rond de eenvoudige vraag:
      wat blijft er over wanneer we stiller worden?
    </p>
  </section>

<HomeHouseMap lang="nl" />
</BaseLayout>