---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
import { upcomingEvents } from "../../data/events";

const base = import.meta.env.BASE_URL;
const hasUpcomingEvents = upcomingEvents.length > 0;
---

<BaseLayout
  title="Bijeenkomsten — Het Huis van Nondualiteit"
  description="Bijeenkomsten van Het Huis van Nondualiteit ontstaan zonder vast programma: als lezing, wandeling, dag samen of avond rond poëzie en tekst."
  lang="nl"
  image="/images/home/hond-home-inn-spring.png"
>
  <PageImageHero
    title="Bijeenkomsten"
    lead="Het Huis krijgt telkens opnieuw vorm wanneer inhoud, plek en moment samenvallen."
    imageSrc="/images/home/hond-home-inn-spring.png"
    imageAlt="Een warm huis met kamers voor ontmoeting, stilte, contact, meditatie en studie."
  >
    <section
      class:list={[
        "hero-card-grid",
        "gatherings-card-grid",
        hasUpcomingEvents && "has-upcoming-events",
      ]}
    >
      <article class="hero-card gatherings-intro-card">
        <h2>Geen vast programma</h2>
        <p>
          Het Huis krijgt geen vorm via een vaste kalender. Soms ontstaat er een
          lezing rond een tekst of thema, soms een langere wandeling in de
          natuur, een avond rond poëzie of een dag met stilte, gesprek en gedeeld
          eten. Een bijeenkomst vindt plaats wanneer er werkelijk ruimte en een
          passende aanleiding voor is.
        </p>
      </article>

      {hasUpcomingEvents && (
        <a class="hero-card gatherings-agenda-card" href={`${base}nl/agenda/`}>
          <h2>Wat er nu gepland is</h2>
          <p>
            Bekijk de bijeenkomsten die momenteel concreet vorm hebben gekregen.
          </p>
          <span class="card-link">Bekijk de agenda</span>
        </a>
      )}

      <article class="hero-card gathering-form-card gatherings-talks-card">
        <p class="gathering-form-kicker">Mogelijke vorm</p>
        <h2>Lezingen en onderzoek</h2>
        <p>
          Een grondige verkenning van een spirituele tekst, een thema uit de
          nondualiteit of een vraag die om verdieping vraagt — met ruimte voor
          uitleg, stilte en gesprek.
        </p>
      </article>

      <article class="hero-card gathering-form-card gatherings-walks-card">
        <p class="gathering-form-kicker">Mogelijke vorm</p>
        <h2>Wandelingen in de natuur</h2>
        <p>
          Langere wandelingen in stiller, wilder groen. Een gedicht, meditatie of
          korte voordracht kan een anker zijn, met daarnaast ruimte om vrij te
          wandelen en samen te zijn.
        </p>
      </article>

      <article class="hero-card gathering-form-card gatherings-days-card">
        <p class="gathering-form-kicker">Mogelijke vorm</p>
        <h2>Dagen samen</h2>
        <p>
          Kleinschalige dagen met enkele gezamenlijke ankerpunten: ontvangst,
          lezing, stilte en gesprek. Soms aangevuld met een gedeelde picknick of
          potluck, zonder dat elk moment ingevuld hoeft te worden.
        </p>
      </article>

      <article class="hero-card gathering-form-card gatherings-poetry-card">
        <p class="gathering-form-kicker">Mogelijke vorm</p>
        <h2>Poëzie en tekst</h2>
        <p>
          Een avond rond één of enkele sterke gedichten of mystieke teksten,
          afgewisseld met stilte, duiding, persoonlijke reflectie en gesprek.
        </p>
      </article>

      <a
        class="hero-card gatherings-newsletter-card"
        href={`${base}nl/nieuwsbrief/`}
      >
        <h2>Wanneer er iets ontstaat</h2>
        <p>
          Nieuwe bijeenkomsten volgen geen vast ritme. Via de nieuwsbrief hoor
          je wanneer een lezing, wandeling of andere ontmoeting vorm krijgt.
        </p>
        <span class="card-link">Schrijf je in op de nieuwsbrief</span>
      </a>

      <article class="hero-card gatherings-history-card">
        <h2>Eerdere vormen</h2>
        <p>
          Open Tafel en Woorden uit de Stilte waren de eerste manieren waarop
          het Huis vorm kreeg. Hun waarde blijft aanwezig, maar ze vormen geen
          vast programma meer.
        </p>

        <nav class="gatherings-history-links" aria-label="Eerdere vormen">
          <a href={`${base}nl/open-tafel/`}>Open Tafel</a>
          <a href={`${base}nl/woorden-uit-de-stilte/`}>Woorden uit de Stilte</a>
        </nav>
      </article>
    </section>
  </PageImageHero>
</BaseLayout>
