---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Bijeenkomsten — Het Huis van Nondualiteit"
  description="Een overzicht van de bijeenkomsten van Het Huis van Nondualiteit: eenvoudige momenten van maaltijd, tekst, stilte, gesprek, poëzie en contemplatie."
  lang="nl"
  image="/images/home/hond-home-inn-spring.png"
>
  <PageImageHero
    title="Bijeenkomsten"
    lead="Terugkerende vormen van samenkomen rond contemplatie, tekst, stilte, maaltijd en ontmoeting in Leuven."
    imageSrc="/images/home/hond-home-inn-spring.png"
    imageAlt="Een warm huis met kamers voor ontmoeting, stilte, contact, meditatie en studie."
  >
    <section class="hero-card-grid gatherings-card-grid">
      <article class="hero-card gatherings-intro-card">
        <h2>Vormen van samenkomen</h2>
        <p>
          Het Huis van Nondualiteit krijgt vorm in eenvoudige bijeenkomsten: 
          een tafel, een tekst, een stilte, een gesprek. 
          Daar ontstaat ruimte om samen te vertragen, 
          te luisteren en aandachtiger te kijken naar wat zich aandient.
        </p>
      </article>

      <a class="hero-card hero-card-open-table" href={`${base}nl/open-tafel/`}>
        <span class="hero-card-arrow hero-card-arrow-left" aria-hidden="true">←</span>
        <h2>Open Tafel</h2>
        <p>
          Een eenvoudige ontmoeting rond eten, stilte, wandeling en
          gesprek.
        </p>
        <span class="card-link">Lees meer</span>
      </a>

      <a class="hero-card hero-card-agenda" href={`${base}nl/agenda/`}>
        <h2>Agenda</h2>
        <p>
          Alle komende bijeenkomsten in één overzicht, met de mogelijkheid om
          ze meteen in je eigen digitale agenda te zetten.
        </p>
        <span class="card-link">Bekijk de agenda</span>
      </a>

      <a class="hero-card hero-card-words" href={`${base}nl/woorden-uit-de-stilte/`}>
        <span class="hero-card-arrow hero-card-arrow-right" aria-hidden="true">→</span>
        <h2>Woorden uit de Stilte</h2>
        <p>
          Een avond met mystieke poëzie en korte teksten, afgewisseld met stilte
          en gesprek.
        </p>
        <span class="card-link">Lees meer</span>
      </a>
    </section>
  </PageImageHero>
</BaseLayout>