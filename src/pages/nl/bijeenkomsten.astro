---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";
---

<BaseLayout
  title="Bijeenkomsten — House of Nonduality"
  description="Bijeenkomsten rond stilte, poëzie, contemplatie en ontmoeting in Leuven."
  lang="nl"
>
  <PageImageHero
    title="Bijeenkomsten"
    lead="Twee terugkerende vormen van samenkomen: een poëzie- en tekstavond rond stilte, en een eenvoudige tafel rond eten, gesprek en aanwezigheid."
    imageSrc="/images/home/hond-home-inn-spring.png"
    imageAlt="Een warme herberg met kamers voor ontmoeting, stilte, contact, meditatie en studie."
  />

  <section class="section">
    <article class="card">
      <h2>Woorden uit de Stilte</h2>
      <p>
        Een avond met mystieke poëzie en korte teksten, afgewisseld met stilte en gesprek.
      </p>
      <p class="card-link"><a href="/nl/woorden-uit-de-stilte/">Lees meer →</a></p>
    </article>

    <article class="card">
      <h2>Open Tafel</h2>
      <p>
        Een eenvoudige ontmoeting rond plantaardig eten, stilte, wandeling en gesprek.
      </p>
      <p class="card-link"><a href="/nl/open-tafel/">Lees meer →</a></p>
    </article>
  </section>
</BaseLayout>