---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const monthNamesNl = [
  "januari",
  "februari",
  "maart",
  "april",
  "mei",
  "juni",
  "juli",
  "augustus",
  "september",
  "oktober",
  "november",
  "december",
];

const getThirdTuesday = (year: number, month: number) => {
  const firstDay = new Date(year, month, 1);
  const firstTuesdayOffset = (2 - firstDay.getDay() + 7) % 7;
  return new Date(year, month, 1 + firstTuesdayOffset + 14);
};

const today = new Date();

const upcomingDates = Array.from({ length: 18 }, (_, index) => {
  const month = today.getMonth() + index;
  const year = today.getFullYear() + Math.floor(month / 12);
  const normalizedMonth = month % 12;

  return getThirdTuesday(year, normalizedMonth);
})
  .filter((date) => date >= today)
  .slice(0, 8);

const dates = upcomingDates.map((date) => {
  return `${date.getDate()} ${monthNamesNl[date.getMonth()]} ${date.getFullYear()}`;
});
---

<BaseLayout
  title="Woorden uit de Stilte — Het Huis van Nondualiteit"
  description="Een rustige avond in Leuven met poëzie, korte teksten, stilte en reflectie rond mystiek, contemplatie en nondualiteit."
  lang="nl"
>
  <PageImageHero
    kicker="Elke derde dinsdag · Leuven"
    title="Woorden uit de Stilte"
    lead="Een rustige avond met poëzie, korte teksten, stilte en reflectie rond mystiek, contemplatie en nondualiteit."
    imageSrc="/images/words/hond-words-from-silence-spring.png"
    imageAlt="Een warme stille leeshoek in het Huis van Nondualiteit, met een open boek, zetel, kaarslicht en zachte namiddagzon."
    showImageView={true}
    imageViewLabel="Bekijk de kamer"
    imageInfoLabel="Toon info"
  >
    <section class="hero-card-grid words-hero-grid words-all-cards">
      <article class="hero-card words-hero-card hero-card-large">
        <h2>Wat is het?</h2>
        <p>
          <em>Woorden uit de Stilte</em> is een rustige avond in Leuven met
          poëzie, korte teksten, stilte en reflectie rond mystiek, contemplatie
          en nondualiteit. Geen klassieke poëzieavond, maar een gezamenlijke
          luisterruimte waarin woorden kunnen wijzen naar stilte.
        </p>
      </article>

      <article class="hero-card words-hero-card">
        <h2>Wat lezen we?</h2>
        <p>
          We lezen teksten uit verschillende mystieke, poëtische en
          contemplatieve tradities: gedichten, korte fragmenten en citaten die
          uitnodigen tot vertraging, aandacht en innerlijke stilte.
        </p>
      </article>

      <article class="hero-card words-hero-card">
        <h2>Wat mag je verwachten?</h2>
        <p>
          De avond bestaat uit een eenvoudige afwisseling van tekst, stilte en
          gesprek. We luisteren, laten de woorden bezinken, en delen waar iets
          resoneert — zonder discussie te moeten voeren of tot een conclusie te
          komen.
        </p>
      </article>

      <article class="hero-card words-hero-card words-compact-card">
        <h2>Praktisch</h2>
        <ul class="detail-meta-list">
          <li>Elke derde dinsdag van de maand</li>
          <li>19:30–21:00</li>
          <li>Leuven — adres na inschrijving</li>
          <li>Nederlands en Engels, afhankelijk van de teksten en wie aanwezig is</li>
          <li>Bijdrage naar draagkracht</li>
        </ul>
      </article>

      <article class="hero-card words-hero-card words-compact-card">
        <h2>Komende data</h2>
        <ul class="detail-meta-list words-date-list">
          {dates.map((date) => <li>{date}</li>)}
        </ul>
      </article>

      <article class="hero-card words-hero-card hero-card-callout">
        <h2>Wil je deelnemen?</h2>
        <p>
          Stuur een bericht via de contactpagina en vermeld je naam, de datum
          waarvoor je wil inschrijven en met hoeveel personen je komt.
        </p>
        <div class="hero-card-actions">
          <a class="button primary" href={withBase("/nl/contact/")}>
            Inschrijven via contact
          </a>
          <a class="button" href={withBase("/nl/nieuwsbrief/")}>
            Nieuwsbrief
          </a>
        </div>
      </article>
    </section>
  </PageImageHero>
</BaseLayout>