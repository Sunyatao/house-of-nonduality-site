---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageImageHero from "../../components/PageImageHero.astro";

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
  const cleanBase = base.endsWith("/") ? base : `${base}/`;
  const cleanPath = path.startsWith("/") ? path.slice(1) : path;

  return `${cleanBase}${cleanPath}`;
};

const archiveUrl = "https://insight.houseofnonduality.com/woorden-uit-de-stilte/overzicht-woorden-uit-de-stilte";
---

<BaseLayout
  title="Woorden uit de Stilte — Het Huis van Nondualiteit"
  description="Woorden uit de Stilte is een rustige bijeenkomst in Leuven met poëzie, korte teksten, stilte en reflectie rond mystiek, contemplatie en nondualiteit."
  lang="nl"
  image="/images/social/words-from-silence-og.jpg"
>
  <PageImageHero
    kicker="Poëzie · stilte · reflectie"
    title="Woorden uit de Stilte"
    lead="Een rustige avond met poëzie, korte teksten, stilte en reflectie rond mystiek, contemplatie en nondualiteit."
    imageSrc="/images/words/hond-words-from-silence-spring.png"
    imageAlt="Een warme stille leeshoek in het Huis van Nondualiteit, met een open boek, zetel, kaarslicht en zachte namiddagzon."
  >
    <div class="words-room-layer" aria-label="Interactieve kamer voor Woorden uit de Stilte">
      <a
        class="words-room-hotspot words-room-hotspot-book"
        href={archiveUrl}
        aria-label="Open de verzamelde avonden van Woorden uit de Stilte"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Verzamelde avonden</span>
      </a>

      <button
        class="words-room-hotspot words-room-hotspot-chair"
        type="button"
        data-words-room-toggle
        aria-controls="words-room-info-nl"
        aria-expanded="false"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Praktisch</span>
      </button>

      <a
        class="words-room-hotspot words-room-hotspot-traces"
        href={withBase("/nl/sporen-van-inzicht/")}
        aria-label="Open Sporen van Inzicht"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Sporen van Inzicht</span>
      </a>

      <a
        class="words-room-hotspot words-room-hotspot-entrance"
        href={withBase("/nl/")}
        aria-label="Keer terug naar de inkomhal"
      >
        <span class="words-room-hotspot-dot" aria-hidden="true"></span>
        <span class="words-room-hotspot-label">Inkomhal</span>
      </a>

      <section
        id="words-room-info-nl"
        class="words-room-panel"
        aria-label="Praktische informatie over Woorden uit de Stilte"
        hidden
      >
        <div class="words-room-panel-inner">
          <button
            class="words-room-panel-close"
            type="button"
            data-words-room-close
            aria-controls="words-room-info-nl"
          >
            Sluiten
          </button>

          <section class="hero-card-grid words-hero-grid words-all-cards">
            <article class="hero-card words-hero-card hero-card-large">
              <h2>Wat is het?</h2>
              <p>
                <em>Woorden uit de Stilte</em> ontstond als een reeks rustige avonden
                met poëzie, korte teksten, stilte en reflectie rond mystiek,
                contemplatie en nondualiteit. Deze vorm kan opnieuw terugkeren, maar
                niet langer volgens een vast maandelijks ritme.
              </p>
            </article>

            <article class="hero-card words-hero-card">
              <h2>Wat lezen we?</h2>
              <p>
                We lezen teksten uit verschillende mystieke, poëtische en
                contemplatieve tradities: gedichten, korte fragmenten en citaten die
                uitnodigen tot vertraging, aandacht en innerlijke stilte.
              </p>
            </article>

            <article class="hero-card words-hero-card">
              <h2>Wat mag je verwachten?</h2>
              <p>
                De avond bestaat uit een eenvoudige afwisseling van tekst, stilte en
                gesprek. Soms is er een korte toelichting, soms een korte uitwisseling,
                soms vooral stilte.
              </p>
            </article>

            <article class="hero-card words-hero-card words-compact-card">
              <h2>Praktisch</h2>
              <ul class="detail-meta-list">
                <li>Niet volgens een vast ritme</li>
                <li>Datum, tijd en locatie worden per bijeenkomst aangekondigd</li>
                <li>Nederlands en Engels, afhankelijk van de teksten en wie aanwezig is</li>
              </ul>
            </article>

            <article class="hero-card words-hero-card words-compact-card">
              <h2>Volgende bijeenkomst</h2>
              <p>Er staat momenteel geen nieuwe avond gepland.</p>
            </article>

            <article class="hero-card words-hero-card words-archive-card">
              <h2>Verzamelde avonden</h2>
              <p>
                Verken de verzamelde avonden, fragmenten, beelden en bronnotities.
              </p>
              <div class="hero-card-actions">
                <a class="button" href={archiveUrl}>
                  Open de verzamelde avonden
                </a>
              </div>
            </article>

            <article class="hero-card words-hero-card hero-card-callout">
              <h2>Wil je weten wanneer deze vorm terugkeert?</h2>
              <p>
                Nieuwe bijeenkomsten worden aangekondigd via de nieuwsbrief.
              </p>
              <div class="hero-card-actions">
                <a class="button primary" href={withBase("/nl/nieuwsbrief/")}>
                  Blijf op de hoogte
                </a>
                <a class="button" href={withBase("/nl/contact/")}>
                  Contact
                </a>
              </div>
            </article>
          </section>
        </div>
      </section>
    </div>
  </PageImageHero>
  <nav class="words-room-mobile-menu" aria-label="Woorden uit de Stilte navigatie">
  <a href={archiveUrl}>Verzamelde avonden</a>

  <button
    type="button"
    data-words-room-toggle
    aria-controls="words-room-info-nl"
    aria-expanded="false"
  >
    Praktisch
  </button>

  <a href={withBase("/nl/sporen-van-inzicht/")}>Sporen van Inzicht</a>
  <a href={withBase("/nl/")}>Inkomhal</a>
</nav>
</BaseLayout>

<script>
  const setWordsRoomPanel = (panel: HTMLElement, open: boolean) => {
    panel.hidden = !open;
    panel.classList.toggle("is-open", open);

    const hero = panel.closest(".page-image-hero");
    hero?.classList.toggle("words-room-panel-open", open);

    const toggle = hero?.querySelector<HTMLElement>(`[data-words-room-toggle][aria-controls="${panel.id}"]`);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");

    if (open) {
      panel.querySelector<HTMLElement>("[data-words-room-close]")?.focus({ preventScroll: true });
    }
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const toggle = target.closest<HTMLElement>("[data-words-room-toggle]");
    if (toggle) {
      const panelId = toggle.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (panel) {
        setWordsRoomPanel(panel, panel.hasAttribute("hidden"));
      }
      return;
    }

    const close = target.closest<HTMLElement>("[data-words-room-close]");
    if (close) {
      const panelId = close.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : close.closest<HTMLElement>(".words-room-panel");
      if (panel) {
        setWordsRoomPanel(panel, false);
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    document.querySelectorAll<HTMLElement>(".words-room-panel.is-open").forEach((panel) => {
      setWordsRoomPanel(panel, false);
    });
  });
</script>
